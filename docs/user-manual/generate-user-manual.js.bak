  ]));
  s.push(NOTE('编辑配电拓扑会影响 PUE 计算和能耗统计的准确性，请确保拓扑结构与实际配电系统一致。建议在系统初始化时由专业电气工程师配置拓扑结构。'));
  s.push(P(''));

  return s;
}


// 7.2.1 资产台账（详细版 - 基于 asset/index.vue 源码分析）

function enriched_section_7_2_1() {
  const s = [];
  s.push(H3('7.2.1 资产台账'));
  s.push(P('资产台账页面是资产管理的核心页面，提供设备资产的全生命周期管理能力。页面顶部为统计卡片区域，中部为保修预警面板，下方为资产数据表格。支持资产的新增、编辑、查看、删除、维护记录、批量导入和导出功能。'));
  s.push(...IMG('31-asset-list.png'));
  s.push(P(''));

  s.push(PBold('顶部统计卡片（6 个）：'));
  s.push(...B([
    '资产总数：系统中登记的所有资产数量',
    '使用中：当前处于"使用中"状态的资产数量',
    '库存中：当前处于"库存"状态的资产数量',
