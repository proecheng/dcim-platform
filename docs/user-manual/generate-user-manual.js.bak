  s.push(P(''));

  return s;
}


// 7.3.1 工单管理（详细版 - 基于 operation/workorder.vue 源码分析）

function enriched_section_7_3_1() {
  const s = [];
  s.push(H3('7.3.1 工单管理'));
  s.push(P('工单管理页面支持运维工单的创建、分配、处理和关闭全流程管理。页面顶部为统计卡片区域，中部为筛选工具栏，下方为工单数据表格。告警可自动触发创建工单，实现告警到运维的闭环流转。'));
  s.push(...IMG('35-operation-workorder.png'));
  s.push(P(''));

  s.push(PBold('顶部统计卡片（4 个）：'));
  s.push(...B([
