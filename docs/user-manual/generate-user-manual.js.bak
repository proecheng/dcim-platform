  s.push(P(''));
  s.push(PBold('筛选条件：'));
  s.push(...B([
    '规则类型：下拉选择框，可选"与"（AND）、"或"（OR）、"序列"三种逻辑类型',
    '告警级别：下拉选择框，按告警级别筛选规则',
    '启用状态：下拉选择框，筛选已启用或已禁用的规则',
  ]));
  s.push(P(''));
  s.push(PBold('规则列表表格列：'));
  s.push(...B([
    '规则名称：规则的标识名称',
    '规则类型：与/或/序列',
    '告警级别：该规则触发时产生的告警级别',
    '告警消息：告警触发时的消息模板',
    '条件表达式：规则的触发条件表达式',
    '启用：开关控件，可直接在列表中启用或禁用规则',
    '创建时间：规则创建的时间',
    '操作列：包含"编辑"和"删除"两个按钮',
  ]));
  s.push(P(''));
  s.push(PBold('新增/编辑规则对话框（宽度 600px）：'));
  s.push(P('点击"新增规则"按钮或操作列的"编辑"按钮，弹出规则编辑对话框，包含以下字段：'));
  s.push(...B([
    '规则名称：文本输入框，填写规则的标识名称',
    '规则类型：下拉选择框，选择"与"（所有条件同时满足）、"或"（任一条件满足）、"序列"（按顺序满足）',
    '条件表达式：多行文本输入框，填写触发条件的表达式',
    '告警级别：下拉选择框，选择触发后产生的告警级别',
    '告警消息：多行文本输入框，填写告警消息模板',
    '启用状态：开关控件，设置规则是否立即启用',
  ]));
  s.push(P(''));
  s.push(PBold('操作步骤 - 创建告警规则：'));
  s.push(...STEPS([
    '切换到"告警规则"标签页',
    '点击"新增规则"按钮，弹出规则编辑对话框',
    '填写规则名称，如"UPS双路故障告警"',
    '选择规则类型为"与"（表示所有条件需同时满足）',
    '在条件表达式中填写触发条件',
    '选择告警级别为"紧急"',
    '填写告警消息模板',
    '开启启用状态开关',
    '点击"确定"按钮保存规则',
