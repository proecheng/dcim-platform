    '在描述中详细说明问题现象',
    '选择工单类型为"故障"',
    '选择优先级为"高"',
    '填写相关设备名称和位置',
    '填写报修人和联系电话',
    '点击"确定"按钮创建工单',
  ]));
  s.push(P(''));

  s.push(PBold('操作步骤 - 处理工单：'));
  s.push(...STEPS([
    '在工单列表中找到分配给自己的工单（状态为"已分配"或"处理中"）',
    '点击操作列的"处理"按钮开始处理',
    '处理过程中，点击"详情"进入工单详情页',
    '点击"添加日志"记录处理进展（选择操作类型为"处理"，填写处理内容）',
    '问题解决后，返回工单列表，点击"完成"按钮',
    '在完成对话框中填写解决方案和根因分析',
    '点击"确定"完成工单',
  ]));
  s.push(P(''));

  s.push(PBold('操作步骤 - 查看工单详情和日志：'));
  s.push(...STEPS([
    '在工单列表中点击操作列的"详情"按钮',
    '查看工单基本信息（编号、状态、描述、处理人等）',
    '向下滚动查看工单日志时间线，了解完整处理过程',
    '如需补充信息，点击"添加日志"按钮添加备注',
  ]));
  s.push(TIP('建议每日检查"待处理"工单，及时响应。紧急工单应在 30 分钟内开始处理。工单完成后务必填写解决方案和根因分析，便于知识积累和后续参考。'));
  s.push(P(''));

  return s;
}


