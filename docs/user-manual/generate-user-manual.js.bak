  s.push(P('告警屏蔽标签页用于临时屏蔽特定点位或全局的告警，避免设备维护期间产生大量无效告警干扰运维工作。'));
  s.push(P(''));
  s.push(PBold('筛选条件：'));
  s.push(...B([
    '点位：下拉选择框（支持搜索过滤），选择要查看屏蔽记录的点位',
    '告警级别：下拉选择框，按告警级别筛选屏蔽记录',
  ]));
  s.push(P(''));
  s.push(PBold('屏蔽列表表格列：'));
  s.push(...B([
    '点位编码：被屏蔽的点位编码',
    '点位名称：被屏蔽的点位名称',
    '屏蔽级别：被屏蔽的告警级别',
    '开始时间：屏蔽生效的起始时间',
    '结束时间：屏蔽失效的截止时间',
    '屏蔽原因：屏蔽操作的原因说明',
    '状态：显示"生效中"或"已过期"',
    '操作列：包含"删除"按钮（仅对生效中的屏蔽可操作）',
  ]));
  s.push(P(''));
  s.push(PBold('新增屏蔽对话框（宽度 600px）：'));
  s.push(P('点击"新增屏蔽"按钮弹出对话框，包含以下字段：'));
  s.push(...B([
    '点位：下拉选择框（支持搜索过滤），可选择具体点位或选择"全局屏蔽"屏蔽所有点位',
    '屏蔽级别：下拉选择框，可选择具体级别或"全部级别"',
    '开始时间：日期时间选择器，设置屏蔽开始时间',
    '结束时间：日期时间选择器，设置屏蔽结束时间',
    '屏蔽原因：文本输入框，填写屏蔽原因（用于审计追溯）',
  ]));
  s.push(P(''));
  s.push(PBold('操作步骤 - 创建告警屏蔽：'));
  s.push(...STEPS([
    '切换到"告警屏蔽"标签页',
    '点击"新增屏蔽"按钮，弹出屏蔽配置对话框',
    '在"点位"下拉框中搜索并选择目标点位，或选择"全局屏蔽"',
    '选择要屏蔽的告警级别，或选择"全部级别"',
    '设置屏蔽的开始时间和结束时间',
    '填写屏蔽原因，如"PDU-A01 定期维护"',
    '点击"确定"按钮，屏蔽策略立即生效',
  ]));
  s.push(NOTE('屏蔽到期后系统自动解除屏蔽，恢复正常告警。建议屏蔽时间不要设置过长，维护完成后及时手动删除屏蔽策略。'));
  s.push(P(''));

  // === 6.4 升级规则 ===
  s.push(H2('6.4 升级规则'));
  s.push(P('升级规则标签页用于配置告警超时自动升级策略。当某级别的告警在指定时间内未被处理时，系统自动将其升级为更高级别并通知相关人员，确保重要告警不被遗漏。'));
  s.push(P(''));
  s.push(PBold('筛选条件：'));
  s.push(...B([
    '源级别：下拉选择框，按告警的原始级别筛选升级规则',
    '启用状态：下拉选择框，筛选已启用或已禁用的规则',
  ]));
  s.push(P(''));
  s.push(PBold('升级规则列表表格列：'));
  s.push(...B([
    '规则名称：升级规则的标识名称',
    '源级别：触发升级的原始告警级别',
    '超时时间（分钟）：告警未处理的等待时间',
    '目标级别：升级后的告警级别',
    '通知人数：升级时需要通知的人员数量',
    '启用：开关控件，可直接启用或禁用规则',
    '描述：规则的补充说明',
    '操作列：包含"编辑"和"删除"两个按钮',
  ]));
  s.push(P(''));
  s.push(PBold('操作步骤 - 创建升级规则：'));
  s.push(...STEPS([
    '切换到"升级规则"标签页',
    '点击"新增规则"按钮',
    '填写规则名称，如"一般告警30分钟升级"',
    '选择源级别为"一般"',
    '设置超时时间为 30 分钟',
    '选择目标级别为"重要"',
    '配置通知人员',
    '点击"确定"保存规则',
  ]));
  s.push(P(''));

  // === 6.5 阈值规则 ===
  s.push(H2('6.5 阈值规则'));
  s.push(P('阈值规则标签页用于管理各监控点位的告警阈值配置。当点位的实时数据超过设定的阈值时，系统自动触发对应级别的告警。'));
  s.push(P(''));
  s.push(PBold('筛选条件：'));
  s.push(...B([
    '阈值类型：下拉选择框，可选"高高"、"高"、"低"、"低低"、"等于"、"变化"六种类型',
    '启用状态：下拉选择框，筛选已启用或已禁用的阈值规则',
  ]));
  s.push(P(''));
  s.push(PBold('阈值规则列表表格列：'));
  s.push(...B([
    '点位名称：关联的监控点位名称',
    '阈值类型：高高/高/低/低低/等于/变化',
    '阈值：设定的阈值数值',
    '告警级别：超过阈值时触发的告警级别',
    '延迟（秒）：超过阈值后等待的延迟时间，避免瞬时波动误报',
    '启用：开关控件，可直接启用或禁用',
    '操作列：包含"编辑"和"删除"两个按钮',
  ]));
  s.push(P(''));
  s.push(PBold('操作步骤 - 创建阈值规则：'));
  s.push(...STEPS([
    '切换到"阈值规则"标签页',
    '点击"新增阈值"按钮',
    '选择目标监控点位',
    '选择阈值类型，如"高"表示超过上限告警',
    '填写阈值数值，如温度上限 35°C',
    '选择告警级别为"重要"',
    '设置延迟时间，如 10 秒（避免瞬时波动误报）',
    '点击"确定"保存阈值规则',
  ]));
  s.push(NOTE('阈值类型说明："高高"为最高限（紧急），"高"为上限（重要），"低"为下限（重要），"低低"为最低限（紧急），"等于"为精确匹配，"变化"为数值变化触发。建议为关键点位同时配置"高"和"高高"两级阈值，实现分级预警。'));
  s.push(P(''));

  s.push(TIP('告警中心的 5 个标签页覆盖了告警管理的完整生命周期：阈值规则定义触发条件 → 告警规则定义组合逻辑 → 告警记录展示和处理告警 → 升级规则防止告警遗漏 → 告警屏蔽避免维护期间干扰。建议运维团队定期审查各标签页的配置，确保告警策略与实际运维需求匹配。'));
  s.push(BREAK());
  return s;
}


// ========== 第7章 管理域 ==========
function chapter7() {
  const sections = [];
  sections.push(H1('第7章 管理域'));
  sections.push(P('管理域涵盖能效管理、资产与容量管理、运维管理和虚拟电厂四大功能模块，为数据中心的日常运营提供全面的管理工具。'));
  sections.push(P(''));

  // 7.1 能效管理
  sections.push(H2('7.1 能效管理'));
  sections.push(P('能效管理模块提供 PUE 监控、能耗统计、节能分析、需量管理等功能，帮助运维团队持续优化数据中心的能源效率，降低运营成本。'));
  sections.push(P(''));

  const energyPages = [
    { h3: '7.1.2 能耗统计', img: '26-energy-statistics.png', desc: '能耗统计页面提供日/月能耗统计、五时段电费分析、同比环比对比等功能，帮助分析电费构成和用电趋势。', features: ['日/月能耗统计报表', '尖峰/高峰/平段/低谷/深谷五时段电费分析', '同比/环比对比图表', '能耗趋势预测'], steps: ['选择统计时间范围（日/月/年）', '查看各时段电费占比，识别优化空间', '对比同比环比数据，评估节能效果', '导出统计报表用于管理汇报'] },
    { h3: '7.1.3 能耗分析', img: '27-energy-analysis.png', desc: '能耗分析页面提供 6 种节能分析插件的运行结果，自动识别节能机会并给出优化建议。', features: ['峰谷套利分析', '需量优化分析', 'PUE 优化建议', '功率因数改善方案', '负荷转移建议', '设备效率提升方案'], steps: ['查看各分析插件的运行结果', '评估每种节能机会的预估节省金额', '选择可行的节能方案进入执行流程', '跟踪已执行方案的实际效果'] },
    { h3: '7.1.4 需量管理', img: '28-energy-regulation.png', desc: '需量管理页面用于监控和管理电力需量，避免超过合同需量导致罚款，优化用电成本。', features: ['实时需量监测', '需量预测和预警', '负荷调控策略', '需量超标告警'], steps: ['查看当前需量和合同需量对比', '关注需量预测曲线，提前调控', '配置负荷调控策略避免超标', '查看历史需量数据优化合同'] },
    { h3: '7.1.5 执行追踪', img: '29-energy-execution.png', desc: '执行追踪页面展示节能方案的执行状态和效果追踪，对比实际节省与预估节省。', features: ['节能方案执行状态', '实际节省 vs 预估节省对比', '执行时间线', '效果评估报告'], steps: ['查看正在执行的节能方案列表', '对比实际效果与预估效果', '评估方案执行偏差原因', '根据效果调整后续方案'] },
    { h3: '7.1.6 能效报告', img: '30-energy-report.png', desc: '能效报告页面支持生成和导出月度能效报告，包含 PUE 趋势、电费对比、节能成果等内容。', features: ['月度能效报告自动生成', 'PUE 趋势分析', '电费同比环比对比', '节能成果汇总', 'Excel/PDF 格式导出'], steps: ['选择报告时间范围', '预览报告内容', '选择导出格式（Excel 或 PDF）', '下载报告用于管理汇报'] },
  ];

  // === 7.1.1 能效监控（详细版）===
  sections.push(...enriched_section_7_1_1());

  energyPages.forEach(page => {
    sections.push(H3(page.h3));
    sections.push(P(page.desc));
    sections.push(...IMG(page.img));
    sections.push(PBold('主要功能：'));
    sections.push(...B(page.features));
    sections.push(PBold('操作步骤：'));
    sections.push(...STEPS(page.steps));
    sections.push(P(''));
  });
  sections.push(BREAK());

  // 7.2 资产与容量
  sections.push(H2('7.2 资产与容量管理'));
  sections.push(P('资产与容量管理模块提供设备资产全生命周期管理、机柜 U 位可视化、四维容量监控和智能上架推荐等功能。'));
  sections.push(P(''));

  const assetPages = [
    { h3: '7.2.2 机柜管理', img: '32-asset-cabinet.png', desc: '机柜管理页面以可视化方式展示每个机柜的 U 位占用情况，支持拖拽调整设备位置。', features: ['42U 机柜 U 位可视化', '设备占用/空闲/预留状态标识', '拖拽调整设备位置', '机柜详细信息（位置、额定功率、承重）'], steps: ['选择目标机柜查看 U 位图', '查看各 U 位的占用状态', '拖拽设备调整位置（需要操作员权限）', '查看机柜的功率和承重使用率'] },
    { h3: '7.2.3 容量管理', img: '33-asset-capacity.png', desc: '容量管理页面展示空间、电力、制冷、承重四维容量的使用情况和趋势预测。', features: ['四维容量使用率仪表盘', '按区域/楼层/房间维度聚合', '容量阈值预警（超过 80% 高亮）', '趋势预测（3/6/12 个月）'], steps: ['查看四维容量使用率概览', '点击某个维度查看详细分布', '关注预警标记的区域', '查看趋势预测评估扩容需求'] },
    { h3: '7.2.4 空间视图', img: '34-asset-spatial.png', desc: '空间视图页面以平面图形式展示机房的物理布局，包括机柜排列、冷热通道、空调位置等。', features: ['机房平面布局图', '机柜状态颜色标识', '智能上架推荐', '故障影响范围可视化'], steps: ['查看机房整体布局', '点击机柜查看详细信息', '使用智能上架推荐功能为新设备选择最优位置', '故障时查看影响范围'] },
  ];

  // === 7.2.1 资产台账（详细版）===
  sections.push(...enriched_section_7_2_1());

  assetPages.forEach(page => {
    sections.push(H3(page.h3));
    sections.push(P(page.desc));
    sections.push(...IMG(page.img));
    sections.push(PBold('主要功能：'));
    sections.push(...B(page.features));
    sections.push(PBold('操作步骤：'));
    sections.push(...STEPS(page.steps));
    sections.push(P(''));
  });
  sections.push(BREAK());

  // 7.3 运维管理
  sections.push(H2('7.3 运维管理'));
  sections.push(P('运维管理模块提供工单管理、巡检管理、知识库、运维报表等功能，支撑运维工作流的规范化和自动化。'));
  sections.push(P(''));

  const opsPages = [
    { h3: '7.3.2 巡检管理', img: '36-operation-inspection.png', desc: '巡检管理页面支持巡检计划的创建和巡检任务的执行，确保日常巡检工作规范化。', features: ['巡检计划配置（路线、检查项、周期）', '巡检任务自动生成', '巡检结果记录（正常/异常/备注）', '巡检统计报表'], steps: ['查看巡检计划列表', '创建巡检计划：设置路线、检查项和执行周期', '执行巡检：按任务逐项记录检查结果', '查看巡检统计评估巡检质量'] },
    { h3: '7.3.3 知识库', img: '37-operation-knowledge.png', desc: '知识库页面用于积累和共享运维经验，包括故障处理方案、操作规程、设备手册等。', features: ['按分类浏览（故障处理、操作规程、设备手册）', '关键词搜索', '富文本编辑器创建文章', '浏览量统计'], steps: ['浏览知识库分类查找相关文章', '使用搜索功能快速定位', '创建新文章分享运维经验', '定期更新和维护知识库内容'] },
    { h3: '7.3.4 运维报表', img: '38-operation-reports.png', desc: '运维报表页面自动生成日报/周报/月报，包含告警趋势、工单统计、设备可用率等运维指标。', features: ['日报/周报/月报自动生成', '告警趋势分析', '工单统计和处理效率', '设备可用率报告'], steps: ['查看已生成的报表列表', '点击报表查看详细内容', '导出报表（Excel/PDF）', '配置报表自动生成周期'] },
    { h3: '7.3.5 历史记录', img: '39-operation-history.png', desc: '历史记录页面汇总展示所有运维操作的历史记录，支持按时间、类型、操作人筛选。', features: ['运维操作时间线', '按类型筛选（工单/巡检/变更）', '操作详情查看', '数据导出'], steps: ['选择时间范围查看历史记录', '使用筛选条件定位特定操作', '点击记录查看详细信息', '导出历史数据用于审计'] },
  ];

  // === 7.3.1 工单管理（详细版）===
  sections.push(...enriched_section_7_3_1());

  opsPages.forEach(page => {
    sections.push(H3(page.h3));
    sections.push(P(page.desc));
    sections.push(...IMG(page.img));
    sections.push(PBold('主要功能：'));
    sections.push(...B(page.features));
    sections.push(PBold('操作步骤：'));
    sections.push(...STEPS(page.steps));
    sections.push(P(''));
  });
  sections.push(BREAK());

  // 7.4 虚拟电厂
  sections.push(H2('7.4 虚拟电厂'));
  sections.push(P('虚拟电厂（VPP）模块将数据中心的柔性负荷资源虚拟化，参与电网需求响应和辅助服务市场，为数据中心创造额外收益。'));
  sections.push(H3('7.4.1 VPP 分析'));
  sections.push(P('VPP 分析页面展示数据中心可调节负荷资源的分析结果，包括可削减负荷量、响应能力评估和收益预测。'));
  sections.push(...IMG('40-vpp-analysis.png'));
  sections.push(PBold('主要功能：'));
  sections.push(...B(['可调节负荷资源识别', '需求响应能力评估', '收益预测模型', '响应策略配置']));
  sections.push(PBold('操作步骤：'));
  sections.push(...STEPS(['查看可调节负荷资源清单', '评估各资源的响应能力和约束条件', '配置需求响应策略', '查看收益预测和历史参与记录']));
  sections.push(P(''));
  sections.push(BREAK());

  return sections;
}

// ========== 第8章 配置域 ==========
function chapter8() {
  const sections = [];
  sections.push(H1('第8章 配置域'));
  sections.push(P('配置域提供系统运行所需的各项配置管理功能，包括采集配置、告警规则、联动策略和智能诊断四大模块。'));
  sections.push(P(''));

  // 8.1 采集配置
  sections.push(H2('8.1 采集配置'));
  sections.push(P('采集配置模块用于管理数据源、设备点位、设备模板和网关等采集相关的配置，是系统数据采集链路的基础。'));
  sections.push(P(''));

  const collectPages = [
    { h3: '8.1.1 设备管理', img: '41-device-manage.png', desc: '设备管理页面展示所有已注册设备的列表，支持设备的增删改查和状态管理。', features: ['设备列表（编码、名称、类型、区域、状态）', '设备详情（基本信息、关联点位、告警规则）', '设备 CRUD 操作', '按类型/区域/状态筛选'], steps: ['查看设备列表，了解设备注册情况', '点击设备查看详细信息和关联点位', '新增设备：点击"新增"填写设备信息', '编辑或删除设备（需管理员权限）'] },
    { h3: '8.1.2 设备状态', img: '42-device-status.png', desc: '设备状态页面以看板形式展示所有设备的在线/离线/告警状态，支持按区域和类型分组查看。', features: ['设备状态看板（在线/离线/告警）', '按区域/类型分组统计', '通信中断检测和影响范围', '设备状态变更历史'], steps: ['查看设备状态概览', '关注离线和告警设备', '点击通信中断设备查看影响范围', '排查离线设备的网络连接'] },
    { h3: '8.1.3 设备点位', img: '43-devices-points.png', desc: '设备点位页面管理设备的监控点位配置，包括点位名称、数据类型、量程、单位等参数。', features: ['点位列表和详情', '点位批量导入（Excel）', '点位数据类型和量程配置', '点位实时值预览'], steps: ['选择设备查看其点位列表', '编辑点位参数（名称、类型、量程、单位）', '批量导入：下载模板，填写后上传', '查看点位实时值验证采集正确性'] },
    { h3: '8.1.4 数据源管理', img: '44-datasources.png', desc: '数据源管理页面配置设备的通信连接参数，支持多种协议（Modbus TCP/RTU、SNMP、MQTT 等）。', features: ['数据源列表和连接状态', '按协议类型动态配置表单', '连接测试功能', '数据源启用/禁用'], steps: ['查看数据源列表和连接状态', '新增数据源：选择协议类型，填写连接参数', '点击"测试连接"验证配置正确性', '启用数据源开始数据采集'] },
    { h3: '8.1.5 设备模板', img: '45-device-templates.png', desc: '设备模板页面管理可复用的设备配置模板，同厂商同型号的设备可共享点位配置。', features: ['模板列表（按厂商/型号分类）', '模板创建和编辑', '从模板创建数据源', '模板导入导出'], steps: ['浏览模板列表查找目标模板', '创建模板：填写厂商、型号和点位配置', '从模板创建数据源：选择模板自动填充配置', '导出模板供其他站点使用'] },
    { h3: '8.1.6 能源配置', img: '46-power-config.png', desc: '能源配置页面管理配电拓扑和电价策略，是能效管理模块的基础配置。', features: ['配电拓扑配置（变压器-配电柜-PDU-机柜）', '电价策略管理（五时段电价）', '能源设备关联', 'PUE 计算参数配置'], steps: ['配置配电拓扑层级关系', '设置电价策略（时段和费率）', '关联能源监测设备', '验证 PUE 计算参数'] },
    { h3: '8.1.7 网关管理', img: '47-gateway.png', desc: '网关管理页面展示所有采集网关的运行状态，支持远程配置下发和固件升级。', features: ['网关列表（在线/离线状态、资源使用率）', '网关详情（CPU/内存/磁盘、负责的数据源）', '远程配置下发', '固件升级（OTA）'], steps: ['查看网关列表和运行状态', '点击网关查看详细资源使用情况', '修改采集配置后点击"下发配置"', '需要时执行固件升级'] },
    { h3: '8.1.8 漂移检测', img: '48-drift-detection.png', desc: '漂移检测页面展示传感器数据漂移检测结果，帮助识别老化或故障的传感器。', features: ['漂移检测结果列表', '3 sigma 统计偏差分析', '相邻传感器交叉验证', '诊断建议'], steps: ['查看漂移检测结果', '关注标记为"疑似漂移"的传感器', '查看诊断建议（校验或更换）', '安排现场校验确认'] },
  ];

  collectPages.forEach(page => {
    sections.push(H3(page.h3));
    sections.push(P(page.desc));
    sections.push(...IMG(page.img));
    sections.push(PBold('主要功能：'));
    sections.push(...B(page.features));
    sections.push(PBold('操作步骤：'));
    sections.push(...STEPS(page.steps));
    sections.push(P(''));
  });
  sections.push(BREAK());

  // 8.2 告警规则
  sections.push(H2('8.2 告警规则配置'));
  sections.push(P('告警规则配置模块用于管理告警阈值、组合规则、升级策略和屏蔽策略，是告警系统的核心配置。'));
  sections.push(P(''));

  const alarmRulePages = [
    { h3: '8.2.1 阈值配置', img: '49-alarm-thresholds.png', desc: '阈值配置页面管理各点位的 4 级告警阈值，支持按设备类型批量设置。', features: ['4 级告警阈值设置（提示/次要/重要/紧急）', '上限和下限阈值', '按设备类型批量配置', '配置变更实时生效'], steps: ['选择设备类型或具体点位', '设置各级别的上限和下限阈值', '使用批量配置功能统一设置同类设备', '保存后配置立即生效'] },
    { h3: '8.2.2 组合规则', img: '50-alarm-compound.png', desc: '组合规则页面配置多条件组合告警规则，支持 AND/OR 逻辑组合。', features: ['多条件组合（AND/OR）', '时间窗口条件', '关联设备条件', '规则启用/禁用'], steps: ['创建组合规则：定义触发条件', '设置条件逻辑关系（AND/OR）', '配置时间窗口和关联条件', '测试规则并启用'] },
    { h3: '8.2.3 升级规则', img: '51-alarm-escalation.png', desc: '升级规则页面配置告警超时升级策略，确保重要告警不被遗漏。', features: ['超时时间配置', '升级后告警级别', '通知对象配置', '升级链路设置'], steps: ['创建升级规则：设置超时时间', '配置升级后的告警级别', '设置通知对象（邮件/短信/系统通知）', '启用规则'] },
    { h3: '8.2.4 屏蔽策略', img: '52-alarm-shield.png', desc: '屏蔽策略页面用于临时屏蔽特定告警，避免维护期间产生大量无效告警。', features: ['按设备/区域/告警类型屏蔽', '屏蔽时间窗口设置', '屏蔽原因记录', '自动解除屏蔽'], steps: ['创建屏蔽策略：选择屏蔽范围', '设置屏蔽时间窗口', '填写屏蔽原因（用于审计）', '到期后系统自动解除屏蔽'] },
  ];

  alarmRulePages.forEach(page => {
    sections.push(H3(page.h3));
    sections.push(P(page.desc));
    sections.push(...IMG(page.img));
    sections.push(PBold('主要功能：'));
    sections.push(...B(page.features));
    sections.push(PBold('操作步骤：'));
    sections.push(...STEPS(page.steps));
    sections.push(P(''));
  });
  sections.push(BREAK());

  // 8.3 联动策略
  sections.push(H2('8.3 联动策略'));
  sections.push(P('联动策略模块配置事件驱动的自动化联动规则，支持告警触发自动执行预设动作序列。'));
  sections.push(P(''));

  const linkagePages = [
    { h3: '8.3.1 联动策略配置', img: '53-linkage-policy.png', desc: '联动策略配置页面管理联动规则，定义触发条件和执行动作。', features: ['联动规则列表', '触发条件配置（告警/事件/定时）', '执行动作配置（MQTT命令/通知/录像/Webhook）', '规则优先级和启用状态'], steps: ['查看联动策略列表', '创建策略：定义触发条件', '配置执行动作序列', '设置优先级并启用'] },
    { h3: '8.3.2 执行记录', img: '54-linkage-execution.png', desc: '执行记录页面展示联动策略的执行历史，包括每次执行的触发原因、动作结果和耗时。', features: ['执行记录列表', '执行详情（触发原因、动作结果）', '成功/失败统计', '执行耗时分析'], steps: ['查看执行记录列表', '点击记录查看详细执行过程', '关注失败的执行记录', '分析执行耗时优化策略'] },
    { h3: '8.3.3 恢复流程', img: '55-linkage-recovery.png', desc: '恢复流程页面管理联动事件的恢复操作，支持一键恢复和逐项手动恢复。', features: ['一键恢复（按预设顺序）', '逐项手动恢复', '恢复状态跟踪', '恢复日志记录'], steps: ['查看待恢复的联动事件', '选择一键恢复或逐项恢复', '跟踪恢复进度', '确认所有项目恢复完成'] },
    { h3: '8.3.4 事件时间线', img: '56-linkage-timeline.png', desc: '事件时间线页面以时间轴形式展示联动事件的完整生命周期，用于事后复盘。', features: ['事件时间轴可视化', '毫秒级时间精度', '动作执行结果标注', '报告导出'], steps: ['选择目标事件查看时间线', '查看各动作的执行时间和结果', '分析响应时间是否满足要求', '导出报告用于复盘和存档'] },
    { h3: '8.3.5 控制命令', img: '57-linkage-command.png', desc: '控制命令页面管理设备控制命令的下发，支持分级确认机制确保操作安全。', features: ['控制命令列表', '分级确认（普通/关键）', '命令执行状态跟踪', '操作审计日志'], steps: ['查看可用控制命令', '选择目标设备和命令', '普通命令：二次确认后执行', '关键命令：提交审批后执行'] },
  ];

  linkagePages.forEach(page => {
    sections.push(H3(page.h3));
    sections.push(P(page.desc));
    sections.push(...IMG(page.img));
    sections.push(PBold('主要功能：'));
    sections.push(...B(page.features));
    sections.push(PBold('操作步骤：'));
    sections.push(...STEPS(page.steps));
    sections.push(P(''));
  });
  sections.push(BREAK());

  // 8.4 智能诊断
  sections.push(H2('8.4 智能诊断'));
  sections.push(P('智能诊断模块基于规则引擎和历史数据分析，自动诊断告警的可能原因并给出处置建议。'));
  sections.push(P(''));

  const diagPages = [
    { h3: '8.4.1 诊断结果', img: '58-diagnosis-results.png', desc: '诊断结果页面展示系统自动诊断的结果列表，包括故障原因分析和处置建议。', features: ['诊断结果列表', '故障原因分析（置信度排序）', '处置建议', '关联告警和设备'], steps: ['查看最新诊断结果', '查看故障原因分析和置信度', '参考处置建议进行故障排查', '关联查看相关告警和设备'] },
    { h3: '8.4.2 诊断规则', img: '59-diagnosis-rules.png', desc: '诊断规则页面管理故障诊断规则，支持规则的创建、编辑和启用/禁用。', features: ['诊断规则列表', '规则条件和结论配置', '规则启用/禁用', '规则测试'], steps: ['查看诊断规则列表', '创建规则：定义触发条件和诊断结论', '测试规则验证诊断逻辑', '启用规则投入使用'] },
  ];

  diagPages.forEach(page => {
    sections.push(H3(page.h3));
    sections.push(P(page.desc));
    sections.push(...IMG(page.img));
    sections.push(PBold('主要功能：'));
    sections.push(...B(page.features));
    sections.push(PBold('操作步骤：'));
    sections.push(...STEPS(page.steps));
    sections.push(P(''));
  });
  sections.push(BREAK());

  return sections;
}

// ========== 第9章 系统管理 ==========
function chapter9() {
  const sections = [];
  sections.push(H1('第9章 系统管理'));
  sections.push(P('系统管理模块提供用户管理、站点管理、审计日志和系统设置等功能，是系统安全和运维管理的基础。'));
  sections.push(P(''));

  const sysPages = [
    { h3: '9.1 用户管理', img: '60-system-users.png', desc: '用户管理页面支持用户账户的创建、编辑、删除和权限分配，仅管理员角色可访问。', features: ['用户列表（用户名、角色、状态、最后登录时间）', '用户 CRUD 操作', '角色分配（管理员/操作员/只读）', '账户启用/禁用', '批量操作'], steps: ['查看用户列表，了解账户分配情况', '创建用户：点击"新增"填写用户信息和角色', '编辑用户：修改角色或重置密码', '禁用离职人员账户（建议禁用而非删除，保留审计记录）'] },
    { h3: '9.2 站点管理', img: '61-system-sites.png', desc: '站点管理页面用于管理多站点配置，支持站点的注册、编辑和数据隔离设置。', features: ['站点列表和详情', '站点注册和配置', '站点级数据隔离', '站点间数据对比'], steps: ['查看站点列表', '注册新站点：填写站点名称、地址等信息', '配置站点的数据隔离策略', '查看跨站点数据对比'] },
    { h3: '9.3 审计日志', img: '62-system-audit-log.png', desc: '审计日志页面记录所有用户操作的完整日志，支持按时间、用户、操作类型筛选，满足合规审计要求。', features: ['操作日志列表（时间、用户、操作类型、详情、IP）', '按时间/用户/操作类型筛选', '日志保留至少 180 天', '日志导出'], steps: ['选择时间范围查看操作日志', '使用筛选条件定位特定操作', '查看操作详情进行安全审计', '导出日志用于合规存档'] },
    { h3: '9.4 系统设置', img: '63-system-settings.png', desc: '系统设置页面管理系统级配置参数，包括密码策略、备份策略、通知设置等。', features: ['密码策略配置（复杂度、过期时间、历史密码限制）', '数据备份策略', '通知设置（邮件/短信）', '系统参数调整'], steps: ['查看当前系统配置', '修改密码策略参数', '配置自动备份策略', '设置通知渠道和接收人'] },
    { h3: '9.5 站点切换', img: '64-system-site-selection.png', desc: '站点切换功能允许有多站点权限的用户在不同站点之间快速切换，查看对应站点的数据。', features: ['站点快速切换', '当前站点标识', '跨站点数据隔离', '统一视图模式'], steps: ['点击顶部导航栏的站点选择器', '选择目标站点', '系统自动切换到目标站点的数据视图', '需要时切换到"统一视图"查看所有站点汇总'] },
  ];

  sysPages.forEach(page => {
    sections.push(H2(page.h3));
    sections.push(P(page.desc));
    sections.push(...IMG(page.img));
    sections.push(PBold('主要功能：'));
    sections.push(...B(page.features));
    sections.push(PBold('操作步骤：'));
    sections.push(...STEPS(page.steps));
    sections.push(P(''));
  });
  sections.push(BREAK());

  return sections;
}

// ========== 第10章 数字孪生大屏 ==========
function chapter10() {
  return [
    H1('第10章 数字孪生大屏'),
    P(''),
    H2('10.1 大屏概述'),
    P('数字孪生大屏是 DCIM 系统的全局态势展示模块，基于 Three.js 构建机房的三维数字孪生模型，将实时监控数据叠加到 3D 场景中，为运维团队提供直观的全局视角。大屏适合在指挥中心的大尺寸显示器上展示，建议使用 4K 分辨率。'),
    ...IMG('65-bigscreen.png'),
    P(''),
    PBold('主要功能：'),
    ...B([
      '3D 机房模型：以三维方式展示机房的物理布局，包括机柜、空调、配电设备等',
      '实时数据叠加：将温度、功率、告警等实时数据叠加到 3D 模型上',
      '热力图展示：以颜色渐变方式展示机房温度分布，快速识别热点区域',
      '告警联动：告警触发时 3D 模型中对应设备闪烁高亮',
      '视角切换：支持自由旋转、缩放和预设视角切换',
      '全屏模式：支持浏览器全屏展示，适合大屏幕使用',
    ]),
    P(''),
    PBold('操作步骤：'),
    ...STEPS([
      '访问大屏入口：在浏览器中打开 http://localhost:3000/bigscreen',
      '查看 3D 模型：使用鼠标拖拽旋转视角，滚轮缩放',
      '查看设备信息：点击 3D 模型中的设备查看实时参数',
      '切换热力图：点击工具栏的"热力图"按钮切换温度热力图显示',
      '全屏展示：按 F11 或点击全屏按钮进入全屏模式',
    ]),
    TIP('大屏页面独立于主系统，可在不登录的情况下通过直接访问 URL 打开（如需认证保护，可在系统设置中配置）。'),
    BREAK(),
  ];
}

