    P('\u7b97\u529b\u4e2d\u5fc3\u667a\u80fd\u76d1\u63a7\u7cfb\u7edf\uff08DCIM\uff09\u662f\u4e00\u5957\u9762\u5411\u6570\u636e\u4e2d\u5fc3\u57fa\u7840\u8bbe\u65bd\u7684\u7efc\u5408\u7ba1\u7406\u5e73\u53f0\uff0c\u65e8\u5728\u4e3a\u8fd0\u7ef4\u56e2\u961f\u63d0\u4f9b\u5168\u65b9\u4f4d\u7684\u53ef\u89c2\u6d4b\u6027\u4e0e\u63a7\u5236\u80fd\u529b\u3002\u7cfb\u7edf\u6db5\u76d6\u4ece\u8bbe\u5907\u6570\u636e\u91c7\u96c6\u3001\u5b9e\u65f6\u76d1\u63a7\u3001\u667a\u80fd\u544a\u8b66\u3001\u80fd\u6e90\u7ba1\u7406\u3001\u8d44\u4ea7\u8fd0\u7ef4\u5230 3D \u6570\u5b57\u5b5e\u751f\u7684\u5b8c\u6574\u529f\u80fd\u94fe\u8def\uff0c\u5e2e\u52a9\u8fd0\u7ef4\u4eba\u5458\u5b9e\u73b0\u5bf9\u6570\u636e\u4e2d\u5fc3\u7684\u7cbe\u7ec6\u5316\u7ba1\u7406\u3002'),
    P(''),
    PBold('\u6838\u5fc3\u80fd\u529b\uff1a'),
    ...B([
      '\u591a\u534f\u8bae\u8bbe\u5907\u91c7\u96c6\uff1a\u652f\u6301 Modbus TCP/RTU\u3001SNMP v2c/v3\u3001MQTT\u3001HTTP/REST\u3001BACnet/IP\u3001OPC-UA \u7b49\u4e3b\u6d41\u5de5\u4e1a\u534f\u8bae',
      '\u5b9e\u65f6\u76d1\u63a7\uff1a\u6db5\u76d6\u4f9b\u914d\u7535\u3001\u5236\u51b7\u3001\u73af\u5883\u3001\u5b89\u9632\u6d88\u9632\u56db\u5927\u5b50\u7cfb\u7edf\uff0c\u6570\u636e\u5237\u65b0\u5ef6\u8fdf\u5c0f\u4e8e 1 \u79d2',
      '\u667a\u80fd\u544a\u8b66\uff1a4 \u7ea7\u544a\u8b66\u4f53\u7cfb\uff08\u63d0\u793a/\u6b21\u8981/\u91cd\u8981/\u7d27\u6025\uff09\uff0c\u652f\u6301\u544a\u8b66\u5347\u7ea7\u3001\u98ce\u66b4\u6291\u5236\u3001\u81ea\u52a8\u6d3e\u5355',
      '\u80fd\u6e90\u7ba1\u7406\uff1aPUE \u5b9e\u65f6\u76d1\u63a7\u3001\u4e94\u65f6\u6bb5\u7535\u4ef7\u7ba1\u7406\u30016 \u79cd\u8282\u80fd\u5206\u6790\u63d2\u4ef6',
      '\u8d44\u4ea7\u8fd0\u7ef4\uff1a\u8d44\u4ea7\u53f0\u8d26\u3001\u673a\u67dc U \u4f4d\u53ef\u89c6\u5316\u3001\u5de5\u5355\u7cfb\u7edf\u3001\u5de1\u68c0\u7ba1\u7406\u3001\u77e5\u8bc6\u5e93',
      '\u8054\u52a8\u5f15\u64ce\uff1a\u4e8b\u4ef6\u9a71\u52a8\u7684\u81ea\u52a8\u5316\u8054\u52a8\uff0c\u652f\u6301\u6d88\u9632\u5206\u7ea7\u8054\u52a8\u7b56\u7565',
      '\u89c6\u9891\u76d1\u63a7\uff1a\u6444\u50cf\u5934\u7ba1\u7406\u3001\u544a\u8b66\u8054\u52a8\u89c6\u9891\u3001PTZ \u4e91\u53f0\u63a7\u5236',
      '3D \u6570\u5b57\u5b5e\u751f\uff1a\u57fa\u4e8e Three.js \u7684\u673a\u623f\u4e09\u7ef4\u6a21\u578b\u3001\u70ed\u529b\u56fe\u3001\u5b9e\u65f6\u6570\u636e\u53e0\u52a0',
      '\u591a\u7ad9\u70b9\u7ba1\u7406\uff1a\u7ad9\u70b9\u7ea7\u6570\u636e\u9694\u79bb\u3001\u7edf\u4e00\u89c6\u56fe\u5207\u6362',
    ]),
    P(''),
    H2('1.2 \u6280\u672f\u67b6\u6784'),
    P('\u7cfb\u7edf\u91c7\u7528\u524d\u540e\u7aef\u5206\u79bb\u7684\u4e09\u5c42\u67b6\u6784\u8bbe\u8ba1\uff0c\u786e\u4fdd\u9ad8\u53ef\u7528\u6027\u3001\u53ef\u6269\u5c55\u6027\u548c\u6613\u7ef4\u62a4\u6027\uff1a'),
    P(''),
    PBold('\u524d\u7aef\u5c42\uff1a'),
    ...B([
      'Vue 3 + TypeScript\uff1a\u73b0\u4ee3\u5316\u524d\u7aef\u6846\u67b6\uff0c\u63d0\u4f9b\u54cd\u5e94\u5f0f\u7528\u6237\u754c\u9762',
      'Element Plus\uff1a\u4f01\u4e1a\u7ea7 UI \u7ec4\u4ef6\u5e93\uff0c\u63d0\u4f9b\u4e30\u5bcc\u7684\u8868\u5355\u3001\u8868\u683c\u3001\u56fe\u8868\u7ec4\u4ef6',
      'ECharts\uff1a\u4e13\u4e1a\u7ea7\u6570\u636e\u53ef\u89c6\u5316\u5e93\uff0c\u7528\u4e8e\u76d1\u63a7\u4eea\u8868\u76d8\u548c\u7edf\u8ba1\u56fe\u8868',
      'Three.js\uff1a3D \u6e32\u67d3\u5f15\u64ce\uff0c\u7528\u4e8e\u6570\u5b57\u5b5e\u751f\u5927\u5c4f',
      'Pinia\uff1a\u72b6\u6001\u7ba1\u7406\uff0c\u7ba1\u7406\u7528\u6237\u4f1a\u8bdd\u3001\u544a\u8b66\u3001\u5b9e\u65f6\u6570\u636e\u7b49\u5168\u5c40\u72b6\u6001',
    ]),
    P(''),
    PBold('\u540e\u7aef\u5c42\uff1a'),
    ...B([
      'FastAPI\uff1a\u9ad8\u6027\u80fd Python \u5f02\u6b65 Web \u6846\u67b6\uff0c\u63d0\u4f9b REST API \u548c WebSocket \u670d\u52a1',
      'SQLAlchemy 2.0\uff1a\u5f02\u6b65 ORM\uff0c\u652f\u6301 SQLite\uff08\u5f00\u53d1\uff09\u548c PostgreSQL + TimescaleDB\uff08\u751f\u4ea7\uff09',
      'JWT \u8ba4\u8bc1\uff1a\u57fa\u4e8e JSON Web Token \u7684\u65e0\u72b6\u6001\u8ba4\u8bc1\uff0c\u652f\u6301\u4ee4\u724c\u5237\u65b0',
      'RBAC \u6743\u9650\uff1a\u57fa\u4e8e\u89d2\u8272\u7684\u8bbf\u95ee\u63a7\u5236\uff08\u7ba1\u7406\u5458/\u64cd\u4f5c\u5458/\u53ea\u8bfb\uff09',
      'WebSocket\uff1a\u5b9e\u65f6\u6570\u636e\u63a8\u9001\u3001\u544a\u8b66\u901a\u77e5\u3001\u7cfb\u7edf\u72b6\u6001\u4e09\u901a\u9053',
    ]),
    P(''),
    PBold('\u6570\u636e\u5c42\uff1a'),
    ...B([
      'SQLite\uff1a\u5f00\u53d1\u73af\u5883\u9ed8\u8ba4\u6570\u636e\u5e93\uff0c\u96f6\u914d\u7f6e\u5373\u53ef\u4f7f\u7528',
      'PostgreSQL + TimescaleDB\uff1a\u751f\u4ea7\u73af\u5883\u63a8\u8350\uff0c\u652f\u6301\u65f6\u5e8f\u6570\u636e\u9ad8\u6548\u5b58\u50a8',
      'Redis\uff1a\u7f13\u5b58\u5c42\uff0c\u52a0\u901f\u5b9e\u65f6\u6570\u636e\u8bbf\u95ee\u548c\u4f1a\u8bdd\u7ba1\u7406',
      'EMQX\uff1aMQTT \u6d88\u606f\u4ee3\u7406\uff0c\u7528\u4e8e\u7f51\u5173\u6570\u636e\u4e0a\u62a5\u548c\u63a7\u5236\u547d\u4ee4\u4e0b\u53d1',
    ]),
    P(''),
    H2('1.3 \u6d4f\u89c8\u5668\u8981\u6c42'),
    P('\u4e3a\u83b7\u5f97\u6700\u4f73\u4f7f\u7528\u4f53\u9a8c\uff0c\u8bf7\u786e\u4fdd\u4f7f\u7528\u4ee5\u4e0b\u6d4f\u89c8\u5668\u4e4b\u4e00\uff1a'),
    ...B([
      'Google Chrome 90+\uff08\u63a8\u8350\uff09',
      'Microsoft Edge 90+',
      'Mozilla Firefox 88+',
      'Apple Safari 14+',
    ]),
    NOTE('\u4e0d\u652f\u6301 Internet Explorer\u3002\u5efa\u8bae\u5c06\u5c4f\u5e55\u5206\u8fa8\u7387\u8bbe\u7f6e\u4e3a 1920\u00d71080 \u6216\u66f4\u9ad8\uff0c\u4ee5\u83b7\u5f97\u6700\u4f73\u663e\u793a\u6548\u679c\u3002\u6570\u5b57\u5b5e\u751f\u5927\u5c4f\u5efa\u8bae\u4f7f\u7528 4K \u5206\u8fa8\u7387\u663e\u793a\u5668\u3002'),
    P(''),
    H2('1.4 \u9ed8\u8ba4\u8d26\u6237'),
    P('\u7cfb\u7edf\u521d\u59cb\u5316\u540e\u63d0\u4f9b\u4ee5\u4e0b\u9ed8\u8ba4\u7ba1\u7406\u5458\u8d26\u6237\uff1a'),
    ...B([
      '\u7528\u6237\u540d\uff1aadmin',
      '\u5bc6\u7801\uff1aadmin123',
      '\u89d2\u8272\uff1a\u7cfb\u7edf\u7ba1\u7406\u5458\uff08\u62e5\u6709\u5168\u90e8\u6743\u9650\uff09',
    ]),
    NOTE('\u9996\u6b21\u767b\u5f55\u540e\u8bf7\u7acb\u5373\u4fee\u6539\u9ed8\u8ba4\u5bc6\u7801\uff0c\u786e\u4fdd\u7cfb\u7edf\u5b89\u5168\u3002\u5bc6\u7801\u8981\u6c42\u81f3\u5c11 8 \u4f4d\uff0c\u5305\u542b\u5927\u5c0f\u5199\u5b57\u6bcd\u3001\u6570\u5b57\u548c\u7279\u6b8a\u5b57\u7b26\u4e2d\u7684\u81f3\u5c11 3 \u7c7b\u3002'),
    P(''),
    H2('1.5 \u529f\u80fd\u6a21\u5757\u603b\u89c8'),
    P('\u7cfb\u7edf\u5305\u542b\u4ee5\u4e0b\u4e3b\u8981\u529f\u80fd\u6a21\u5757\uff1a'),
    ...N([
      '\u76d1\u63a7\u57df\uff1a\u4f9b\u914d\u7535\u76d1\u63a7\u3001\u5236\u51b7\u76d1\u63a7\u3001\u73af\u5883\u76d1\u63a7\u3001\u5b89\u9632\u6d88\u9632\u76d1\u63a7',
      '\u544a\u8b66\u4e2d\u5fc3\uff1a\u5b9e\u65f6\u544a\u8b66\u3001\u5386\u53f2\u544a\u8b66\u3001\u544a\u8b66\u7edf\u8ba1\u3001\u544a\u8b66\u5904\u7406\u95ed\u73af',
      '\u7ba1\u7406\u57df\uff1a\u80fd\u6548\u7ba1\u7406\u3001\u8d44\u4ea7\u4e0e\u5bb9\u91cf\u3001\u8fd0\u7ef4\u7ba1\u7406\u3001\u865a\u62df\u7535\u5382',
      '\u914d\u7f6e\u57df\uff1a\u91c7\u96c6\u914d\u7f6e\u3001\u544a\u8b66\u89c4\u5219\u3001\u8054\u52a8\u7b56\u7565\u3001\u667a\u80fd\u8bca\u65ad',
      '\u7cfb\u7edf\u7ba1\u7406\uff1a\u7528\u6237\u7ba1\u7406\u3001\u7ad9\u70b9\u7ba1\u7406\u3001\u5ba1\u8ba1\u65e5\u5fd7\u3001\u7cfb\u7edf\u8bbe\u7f6e',
      '\u6570\u5b57\u5b5e\u751f\u5927\u5c4f\uff1a3D \u673a\u623f\u6a21\u578b\u3001\u5b9e\u65f6\u6570\u636e\u53e0\u52a0\u3001\u70ed\u529b\u56fe\u5c55\u793a',
    ]),
    BREAK(),
  ];
}


// ========== 第2章 安装配置指南 ==========
function chapter2() {
  return [
    H1('第2章 安装配置指南'),
    P('本章指导用户完成 DCIM 系统的安装、配置与首次启动，涵盖三种部署方式，适用于不同的使用场景。'),
    P(''),
    H2('2.1 环境要求'),
    P('根据部署方式的不同，系统对运行环境有以下要求：'),
    P(''),
    PBold('Docker Compose 部署（推荐用于生产环境）：'),
    ...B([
      '操作系统：Linux（Ubuntu 20.04+）或 Windows Server 2019+，推荐 Ubuntu 22.04 LTS',
      'CPU：最低 4 核，推荐 8 核',
      '内存：最低 8 GB，推荐 16 GB',
      '磁盘：最低 50 GB SSD，推荐 200 GB SSD',
      'Docker：20.10+，Docker Compose：2.0+',
    ]),
    P(''),
    PBold('手动部署（适用于开发测试）：'),
    ...B([
      'Python：3.9+，推荐 3.11+',
      'Node.js：18+，推荐 20 LTS',
      'npm：8+，推荐 10+',
      'Nginx：1.18+（Linux 手动部署时需要），推荐 1.24+',
    ]),
    P(''),
    H2('2.2 方式一：Docker Compose 部署（推荐）'),
    P('Docker Compose 是生产环境推荐的部署方式，一键编排 5 个服务容器：PostgreSQL + TimescaleDB 时序数据库、Redis 缓存、EMQX MQTT 代理、FastAPI 后端、Nginx 前端。'),
    P(''),
    PBold('操作步骤：'),
    ...STEPS([
      '确认 Docker 和 Docker Compose 已安装：执行 docker --version 和 docker compose version 验证版本',
      '在项目根目录创建 .env 环境变量文件，配置数据库密码、JWT 密钥、CORS 来源等参数（详见 2.5 节环境变量说明）',
      '执行 docker compose up -d --build 构建并启动所有服务（首次构建约需 5-10 分钟）',
      '执行 docker compose ps 确认所有服务状态为 Up (healthy)',
      '执行 curl http://localhost:8080/api/health 验证后端健康状态，预期返回 {"status":"healthy"}',
      '打开浏览器访问 http://localhost:3000，使用默认账户 admin / admin123 登录系统',
    ]),
    P(''),
    PBold('停止与清理：'),
    ...B([
      '停止所有服务：docker compose down',
      '停止并删除数据卷（会丢失所有数据）：docker compose down -v',
      '代码更新后重新构建：docker compose up -d --build',
    ]),
    P(''),
    H2('2.3 方式二：Windows 一键启动'),
    P('适用于开发测试和演示环境，使用 SQLite 数据库 + Express 代理，无需安装 Docker。'),
    P(''),
    PBold('前置条件：'),
    ...B([
      '已安装 Python 3.9+',
      '已安装 Node.js 18+',
    ]),
    P(''),
    PBold('操作步骤：'),
    ...STEPS([
      '打开命令提示符或 PowerShell，进入项目根目录',
      '执行 stop.bat 停止可能存在的旧服务',
      '执行 start.bat 一键启动（脚本内置端口清理逻辑，会自动安装依赖、初始化数据库、构建前端、启动后端和代理）',
      '等待脚本输出"服务已启动"提示，打开浏览器访问 http://localhost:3000',
      '使用默认账户 admin / admin123 登录',
    ]),
    NOTE('start.bat 使用静态文件模式，修改前端代码后需手动执行 cd frontend && npm run build 并强制刷新浏览器（Ctrl+Shift+R）。如需前端热更新，建议使用 cd frontend && npm run dev（端口 5173）。'),
    P(''),
    H2('2.4 方式三：手动部署'),
    P('适用于需要精细控制各组件的场景，分为 Windows 和 Linux 两种环境。'),
    P(''),
    H3('2.4.1 Windows 手动部署'),
    PBold('操作步骤：'),
    ...STEPS([
      '安装 Python 3.11+（从 python.org 下载）和 Node.js 18+（从 nodejs.org 下载），验证：python --version 和 node --version',
      '部署后端：进入 backend 目录，创建虚拟环境 python -m venv .venv，激活 .venv\\Scripts\\activate，安装依赖 pip install -r requirements.txt',
      '初始化数据库：执行 alembic upgrade head 运行数据库迁移',
      '启动后端：执行 python -m uvicorn app.main:app --host 0.0.0.0 --port 8080 --workers 4',
      '构建前端：进入 frontend 目录，执行 npm install 安装依赖，执行 npm run build 构建生产版本',
      '启动代理：进入 proxy 目录，执行 npm install 安装依赖，执行 node server.js 启动代理服务（端口 3000）',
    ]),
    P(''),
    H3('2.4.2 Linux 手动部署（Nginx + systemd）'),
    PBold('操作步骤：'),
    ...STEPS([
      '安装系统依赖：sudo apt update && sudo apt install -y python3.11 python3.11-venv nodejs npm nginx',
      '部署后端：进入 /opt/mytest1/backend，创建虚拟环境并安装依赖，执行 alembic upgrade head',
      '配置 systemd 服务：创建 /etc/systemd/system/dcim-backend.service 文件，设置 ExecStart 为 uvicorn 启动命令',
      '启用并启动后端服务：sudo systemctl daemon-reload && sudo systemctl enable dcim-backend && sudo systemctl start dcim-backend',
      '构建前端：进入 frontend 目录，执行 npm install && npm run build',
      '配置 Nginx：创建 /etc/nginx/sites-available/dcim 配置文件，设置静态文件服务、API 反向代理（/api/ 转发到 8080）和 WebSocket 代理（/ws/ 转发到 8080）',
      '启用 Nginx 配置：sudo ln -s /etc/nginx/sites-available/dcim /etc/nginx/sites-enabled/ && sudo nginx -t && sudo systemctl reload nginx',
    ]),
    P(''),
    H2('2.5 环境变量说明'),
    P('以下是系统支持的主要环境变量，通过项目根目录的 .env 文件配置：'),
    P(''),
    PBold('应用配置：'),
    ...B([
      'APP_NAME：应用名称，默认"算力中心智能监控系统"',
      'DEBUG：调试模式，生产环境必须设为 false',
    ]),
    PBold('数据库配置：'),
    ...B([
      'DATABASE_URL：数据库连接字符串，默认 sqlite+aiosqlite:///./dcim.db，生产环境使用 postgresql+asyncpg://...',
      'TIMESCALEDB_ENABLED：是否启用 TimescaleDB 扩展，默认 true',
      'POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD：PostgreSQL 数据库名、用户名、密码',
    ]),
    PBold('安全配置：'),
    ...B([
      'SECRET_KEY：JWT 签名密钥，生产环境必须修改为至少 32 位随机字符串',
      'ACCESS_TOKEN_EXPIRE_MINUTES：访问令牌过期时间，默认 30 分钟',
      'REFRESH_TOKEN_EXPIRE_DAYS：刷新令牌过期时间，默认 7 天',
      'CORS_ORIGINS：允许的跨域来源，默认 http://localhost:3000',
    ]),
    PBold('数据采集配置：'),
    ...B([
      'SIMULATION_ENABLED：是否启用数据模拟器，默认 true（生产环境建议关闭）',
      'COLLECT_INTERVAL：数据采集间隔（秒），默认 10',
      'DATA_RETENTION_DAYS：历史数据保留天数，默认 30',
      'MAX_POINTS：最大监控点位数，默认 100',
    ]),
    P(''),
    H2('2.6 安全加固'),
    P('生产环境部署后，请务必执行以下安全措施：'),
    ...STEPS([
      '修改 JWT 密钥：将 SECRET_KEY 设置为随机生成的强密钥',
      '修改数据库密码：将 POSTGRES_PASSWORD 设置为强密码',
      '限制 CORS 来源：将 CORS_ORIGINS 设置为实际域名',
      '关闭调试模式：确保 DEBUG=false',
      '修改默认管理员密码：首次登录后立即修改 admin 账户密码',
      '配置 HTTPS：使用 Certbot 获取免费 SSL 证书，或配置企业证书',
      '配置 MQTT 认证：设置 MQTT_USERNAME 和 MQTT_PASSWORD',
    ]),
    P(''),
    H2('2.7 数据备份'),
    P('系统支持多种数据备份方式，建议定期执行备份以防数据丢失：'),
    P(''),
    PBold('SQLite 备份（开发环境）：'),
    ...B([
      '备份：复制 backend/dcim.db 文件到安全位置',
      '恢复：将备份文件覆盖 backend/dcim.db，重启后端服务',
    ]),
    PBold('PostgreSQL 备份（生产环境）：'),
    ...B([
      '备份：docker exec dcim-postgres pg_dump -U dcim dcim > dcim_backup.sql',
      '恢复：docker exec -i dcim-postgres psql -U dcim dcim < dcim_backup.sql',
      '建议配置 crontab 定时任务，每天凌晨自动备份',
    ]),
    P(''),
    H2('2.8 验证部署'),
    P('部署完成后，按以下步骤验证系统是否正常运行：'),
    ...STEPS([
      '访问 http://localhost:3000，确认登录页面正常显示',
      '使用 admin / admin123 登录，确认进入综合概览仪表盘',
      '检查仪表盘数据是否正常刷新（如启用了模拟器，应看到实时数据变化）',
      '访问 http://localhost:8080/docs，确认 Swagger API 文档可正常访问',
      '检查告警中心是否有异常告警',
    ]),
    TIP('如遇到问题，请参阅附录B 常见问题解答，或检查后端日志输出。'),
    BREAK(),
  ];
}

// ========== 第3章 系统登录 ==========
function chapter3() {
  return [
    H1('第3章 系统登录'),
    P(''),
    H2('3.1 登录页面'),
    P('打开浏览器，访问系统入口地址（默认 http://localhost:3000），系统将显示登录页面。登录页面采用简洁的卡片式设计，包含用户名输入框、密码输入框和登录按钮。'),
    ...IMG('01-login.png'),
    P(''),
    PBold('登录操作步骤：'),
    ...STEPS([
      '在"用户名"输入框中输入您的账户名（首次使用请输入 admin）',
      '在"密码"输入框中输入对应密码（首次使用请输入 admin123）',
      '点击"登录"按钮，系统将验证您的身份信息',
      '验证通过后，系统自动跳转到综合概览仪表盘页面',
    ]),
    P(''),
    PBold('认证机制说明：'),
    ...B([
      '系统采用 JWT（JSON Web Token）进行会话管理，登录成功后浏览器会自动保存访问令牌',
      '访问令牌默认有效期为 30 分钟，过期后系统会自动使用刷新令牌获取新的访问令牌',
      '刷新令牌默认有效期为 7 天，超过后需要重新登录',
      '同一账户支持并发会话限制，超出限制时最早的会话将被踢出',
    ]),
    P(''),
    PBold('登录失败处理：'),
    ...B([
      '用户名或密码错误：系统提示"用户名或密码错误"，请检查输入是否正确',
      '账户被禁用：联系系统管理员启用账户',
      '登录限流：连续 5 次登录失败后，系统将暂时限制该账户的登录尝试，请稍后再试',
    ]),
    NOTE('首次登录后请立即修改默认密码。进入"系统管理 - 系统设置"页面可修改密码。'),
    BREAK(),
  ];
}

// ========== 第4章 综合概览 ==========
function chapter4() {
  return [
    H1('第4章 综合概览'),
    P(''),
    H2('4.1 仪表盘总览'),
    P('登录成功后，系统默认进入综合概览仪表盘页面。该页面是整个 DCIM 系统的信息枢纽，以可视化方式聚合展示数据中心的核心运行指标，帮助运维人员快速掌握全局态势。'),
    ...IMG('02-dashboard.png'),
    P(''),
    PBold('页面主要区域：'),
    ...B([
      '顶部统计卡片：显示设备总数、在线设备数、当前告警数、今日能耗等关键指标',
      '告警分布图：按告警级别（提示/次要/重要/紧急）展示当前活跃告警的分布情况',
      'PUE 趋势图：展示近期 PUE（电能利用效率）的变化趋势，帮助评估能效水平',
      '子系统状态概览：以卡片形式展示供配电、制冷、环境、安防四大子系统的运行状态摘要',
      '最近告警列表：显示最新的告警事件，支持快速跳转到告警详情',
    ]),
    P(''),
    PBold('操作指南：'),
    ...STEPS([
      '查看顶部统计卡片，快速了解设备在线率和告警情况',
      '关注 PUE 趋势图，如果 PUE 值持续上升，可能需要检查制冷系统或优化能源配置',
      '点击告警分布图中的某个级别，可快速跳转到对应级别的告警列表',
      '点击子系统状态卡片，可直接进入对应子系统的详细监控页面',
      '查看最近告警列表，对紧急告警及时响应处理',
    ]),
    TIP('仪表盘数据通过 WebSocket 实时推送，无需手动刷新。如果数据长时间未更新，请检查网络连接或后端服务状态。'),
    BREAK(),
  ];
}

// ========== 第5章 监控域 ==========
function chapter5() {
  const sections = [];
  sections.push(H1('第5章 监控域'));
  sections.push(P('监控域是 DCIM 系统的核心功能区域，涵盖供配电、制冷、环境、安防消防四大子系统的实时监控能力。通过 WebSocket 实时数据推送，运维人员可以在第一时间掌握机房各子系统的运行状态。'));
  sections.push(P(''));

  // 5.1 供配电监控
  sections.push(H2('5.1 供配电监控'));
  sections.push(P('供配电监控子系统负责监控数据中心的电力供应链路，从市电输入、变压器、UPS、电池组到机柜 PDU 的完整配电路径，确保供电安全与稳定。'));
  sections.push(P(''));

  const powerPages = [
    { h3: '5.1.1 供配电总览', img: '03-power-overview.png', desc: '供配电总览页面以仪表盘形式展示整个配电系统的运行状态，包括总输入功率、IT 负载功率、UPS 运行状态、电池健康度等关键指标。页面顶部显示配电系统的整体健康评分，下方以卡片和图表形式展示各配电设备的实时数据。', features: ['总输入功率与 IT 负载功率实时显示', 'UPS 在线/旁路/电池模式状态指示', '电池组 SOH（健康度）和剩余备电时间', '配电系统告警汇总'], steps: ['查看总功率和负载率，评估配电系统余量', '检查 UPS 运行模式，确认处于在线模式', '关注电池 SOH 值，低于 80% 时应安排更换', '点击设备卡片查看详细参数和历史曲线'] },
    { h3: '5.1.2 UPS 监控', img: '04-power-ups.png', desc: 'UPS 监控页面详细展示每台 UPS 的运行参数，包括输入/输出电压、电流、频率、负载率、温度等。支持按区域筛选和状态过滤。', features: ['UPS 输入/输出三相电压电流实时监测', '负载率趋势图和历史对比', '运行模式切换记录', '故障告警与维保提醒'], steps: ['选择目标区域查看对应 UPS 列表', '检查各 UPS 负载率，建议保持在 40%-70% 之间', '查看输入电压是否在正常范围（380V ±10%）', '关注温度参数，过高时检查散热环境'] },
    { h3: '5.1.3 电池监控', img: '05-power-battery.png', desc: '电池监控页面展示 UPS 电池组的详细状态，包括电池电压、内阻、温度、充放电状态和健康度评估。', features: ['电池组总电压和单体电压监测', '内阻趋势分析（内阻上升预示电池老化）', '充放电循环次数统计', '电池健康度评分和更换建议'], steps: ['查看电池组总电压是否在正常范围', '对比各单体电池电压，偏差过大需排查', '关注内阻趋势，持续上升时安排维保', '查看健康度评分，低于 60% 建议更换'] },
    { h3: '5.1.4 机柜配电', img: '06-power-cabinet.png', desc: '机柜配电页面展示每个机柜的用电情况，包括机柜总功率、各路 PDU 的负载分配、三相平衡度等。', features: ['机柜实时功率和额定功率对比', 'PDU 各路输出电流监测', '三相不平衡度计算和预警', '机柜用电趋势分析'], steps: ['选择目标机柜查看配电详情', '检查机柜功率是否接近额定值', '查看三相平衡度，不平衡度超过 20% 需调整负载分配', '对比历史用电趋势，评估容量规划'] },
    { h3: '5.1.5 PDU 监控', img: '07-power-pdu.png', desc: 'PDU 监控页面展示每台 PDU 的详细参数，包括输入电压、各路输出电流、功率因数、温度等。', features: ['PDU 输入电压和总电流监测', '各路输出电流和功率实时显示', '功率因数监测', '过载预警和历史记录'], steps: ['查看 PDU 列表，关注过载预警标记', '检查各路输出电流是否均衡', '功率因数低于 0.9 时需检查负载类型', '查看历史数据评估负载增长趋势'] },
  ];

  powerPages.forEach(page => {
    sections.push(H3(page.h3));
    sections.push(P(page.desc));
    sections.push(...IMG(page.img));
    sections.push(PBold('主要功能：'));
    sections.push(...B(page.features));
    sections.push(PBold('操作步骤：'));
    sections.push(...STEPS(page.steps));
    sections.push(P(''));
  });

  // === 5.1.6 三相接线配置（详细版）===
  sections.push(...enriched_section_5_1_6());

  sections.push(BREAK());

  // 5.2 制冷监控
  sections.push(H2('5.2 制冷监控'));
  sections.push(P('制冷监控子系统负责监控数据中心的温控设备，包括精密空调、冷冻水系统、冷通道封闭系统等，确保机房温湿度维持在安全范围内。'));
  sections.push(P(''));

  const coolingPages = [
    { h3: '5.2.1 制冷总览', img: '09-cooling-overview.png', desc: '制冷总览页面展示整个制冷系统的运行状态概览，包括空调运行台数、平均送风温度、回风温度、制冷量等关键指标。', features: ['空调运行/待机/故障台数统计', '平均送风温度和回风温度', '制冷系统总制冷量', '能效比（COP）监测'], steps: ['查看空调运行台数，确认冗余配置', '检查送风温度是否在设定范围（18-22°C）', '关注回风温度，过高说明制冷能力不足', '查看 COP 值评估制冷效率'] },
    { h3: '5.2.2 室内机组', img: '10-cooling-indoor.png', desc: '室内机组页面展示每台精密空调室内机的详细运行参数，包括送风温度、回风温度、湿度、风速、运行模式等。', features: ['各空调送风/回风温湿度实时监测', '运行模式（制冷/加热/除湿/送风）显示', '滤网堵塞预警', '运行时长统计'], steps: ['选择目标区域查看空调列表', '检查各空调送风温度是否一致', '关注滤网堵塞预警，及时安排清洗', '查看运行时长，评估维保周期'] },
    { h3: '5.2.3 室外机组', img: '11-cooling-outdoor.png', desc: '室外机组页面展示冷凝器/室外机的运行状态，包括冷凝温度、压缩机状态、风扇转速等。', features: ['冷凝温度和压力监测', '压缩机运行状态和频率', '风扇转速控制', '环境温度对制冷效率的影响分析'], steps: ['检查冷凝温度是否在正常范围', '确认压缩机运行正常', '高温天气关注室外机散热效率', '对比室内外温差评估系统效率'] },
    { h3: '5.2.4 冷通道监控', img: '12-cooling-cold-aisle.png', desc: '冷通道监控页面展示冷通道封闭区域的温度分布，帮助识别热点和冷量不均问题。', features: ['冷通道入口温度分布', '热通道回风温度监测', '温度梯度可视化', '热点预警'], steps: ['查看冷通道温度分布图', '识别温度异常偏高的区域', '对比冷热通道温差评估气流组织', '发现热点时检查机柜负载和气流'] },
    { h3: '5.2.5 群控管理', img: '13-cooling-group-control.png', desc: '群控管理页面用于管理空调群控策略，实现多台空调的协调运行，优化制冷效率和能耗。', features: ['空调分组管理', '群控策略配置（轮换、负载均衡）', '节能模式设置', '群控执行日志'], steps: ['查看当前群控分组和策略', '根据季节调整群控参数', '启用节能模式降低非高峰时段能耗', '查看执行日志确认策略生效'] },
  ];

  coolingPages.forEach(page => {
    sections.push(H3(page.h3));
    sections.push(P(page.desc));
    sections.push(...IMG(page.img));
    sections.push(PBold('主要功能：'));
    sections.push(...B(page.features));
    sections.push(PBold('操作步骤：'));
    sections.push(...STEPS(page.steps));
    sections.push(P(''));
  });
  sections.push(BREAK());

  // 5.3 环境监控
  sections.push(H2('5.3 环境监控'));
  sections.push(P('环境监控子系统负责监控机房的温湿度、漏水、烟雾、红外等环境参数，及时发现环境异常并触发告警。'));
  sections.push(P(''));

  const envPages = [
    { h3: '5.3.1 环境总览', img: '14-env-overview.png', desc: '环境总览页面以热力图和统计卡片形式展示机房各区域的温湿度分布，帮助快速识别环境异常区域。', features: ['机房温湿度热力图', '各区域温湿度统计', '环境告警汇总', '历史趋势对比'], steps: ['查看温湿度热力图，识别异常区域', '检查各区域温度是否在 18-27°C 范围内', '检查湿度是否在 40%-60% 范围内', '关注环境告警并及时处理'] },
    { h3: '5.3.2 温湿度监控', img: '15-env-temperature.png', desc: '温湿度监控页面展示每个温湿度传感器的实时数据和历史趋势，支持按区域和位置筛选。', features: ['传感器实时温湿度数据', '历史趋势曲线', '阈值预警线标注', '传感器健康状态'], steps: ['选择目标区域查看传感器列表', '查看实时温湿度值', '对比历史趋势识别异常波动', '关注传感器健康状态，异常时安排校验'] },
    { h3: '5.3.3 漏水检测', img: '16-env-water-leak.png', desc: '漏水检测页面展示漏水传感器的布局和状态，一旦检测到漏水立即触发紧急告警。', features: ['漏水传感器布局图', '实时漏水状态监测', '漏水告警历史', '传感器在线状态'], steps: ['查看漏水传感器布局，确认覆盖关键区域', '检查所有传感器在线状态', '漏水告警触发时立即到现场排查', '定期检查传感器灵敏度'] },
    { h3: '5.3.4 烟雾与红外', img: '17-env-smoke-infrared.png', desc: '烟雾与红外监控页面展示烟雾探测器和红外传感器的状态，用于火灾预警和人员入侵检测。', features: ['烟雾探测器状态监测', '红外传感器触发记录', '消防联动状态', 'VESDA 极早期烟雾检测'], steps: ['确认所有烟雾探测器在线', '查看红外传感器触发记录', '烟雾告警触发时按消防预案响应', '定期测试探测器灵敏度'] },
  ];

  envPages.forEach(page => {
    sections.push(H3(page.h3));
    sections.push(P(page.desc));
    sections.push(...IMG(page.img));
    sections.push(PBold('主要功能：'));
    sections.push(...B(page.features));
    sections.push(PBold('操作步骤：'));
    sections.push(...STEPS(page.steps));
    sections.push(P(''));
  });
  sections.push(BREAK());

  // 5.4 安防消防
  sections.push(H2('5.4 安防消防监控'));
  sections.push(P('安防消防子系统集成门禁控制、视频监控和消防联动功能，保障机房的物理安全和消防安全。'));
  sections.push(P(''));

  const securityPages = [
    { h3: '5.4.1 安防总览', img: '18-security-overview.png', desc: '安防总览页面汇总展示门禁、视频、消防三大安防子系统的运行状态，包括门禁通行记录、摄像头在线率、消防系统状态等。', features: ['门禁系统状态和今日通行统计', '摄像头在线/离线统计', '消防系统运行状态', '安防告警汇总'], steps: ['查看各安防子系统状态概览', '关注离线摄像头，及时排查', '确认消防系统处于正常监控状态', '查看安防告警并处理'] },
    { h3: '5.4.2 门禁管理', img: '19-security-access-control.png', desc: '门禁管理页面展示各门禁点的状态和通行记录，支持远程开门和权限管理。', features: ['门禁点状态（开/关/异常）', '通行记录查询', '远程开门控制', '门禁权限配置'], steps: ['查看各门禁点实时状态', '查询通行记录进行安全审计', '需要时使用远程开门功能', '配置门禁权限控制人员出入'] },
    { h3: '5.4.3 视频监控', img: '20-video-cameras.png', desc: '视频监控页面展示所有摄像头的实时画面，支持多分屏布局和全屏查看。', features: ['摄像头实时画面预览', '1/4/9 分屏布局切换', '摄像头列表和状态管理', '区域分组查看'], steps: ['选择目标区域查看摄像头列表', '点击摄像头查看实时画面', '切换分屏布局查看多路画面', '发现异常时截图或标记'] },
    { h3: '5.4.4 云台控制', img: '21-video-control.png', desc: '云台控制页面提供 PTZ（Pan-Tilt-Zoom）摄像头的远程控制功能，支持方向控制、变焦和预置位调用。', features: ['PTZ 方向控制（上下左右）', '变焦控制（放大/缩小）', '预置位保存和调用', '操作日志记录'], steps: ['选择支持 PTZ 的摄像头', '使用方向键控制云台转动', '使用变焦功能查看细节', '保存常用角度为预置位'] },
    { h3: '5.4.5 录像回放', img: '22-video-playback.png', desc: '录像回放页面支持按时间段检索和回放历史录像，用于事件复盘和安全审计。', features: ['按时间段检索录像', '播放控制（快进/快退/暂停）', '关键帧截图', '告警关联录像快速定位'], steps: ['选择摄像头和时间范围', '播放录像查看历史画面', '使用快进功能快速浏览', '通过告警时间快速定位关键片段'] },
    { h3: '5.4.6 消防联动', img: '23-security-fire-linkage.png', desc: '消防联动页面展示消防联动策略的配置和执行状态，支持消防分级联动（预警级和联动级）。', features: ['消防联动策略配置', '分级联动（预警级/联动级）', '联动执行状态监控', '联动恢复操作'], steps: ['查看当前消防联动策略配置', '确认各级联动动作设置正确', '消防告警触发时监控联动执行状态', '事件解除后执行联动恢复操作'] },
  ];

  securityPages.forEach(page => {
    sections.push(H3(page.h3));
    sections.push(P(page.desc));
    sections.push(...IMG(page.img));
    sections.push(PBold('主要功能：'));
    sections.push(...B(page.features));
    sections.push(PBold('操作步骤：'));
    sections.push(...STEPS(page.steps));
    sections.push(P(''));
  });
  sections.push(BREAK());

  return sections;
}

// 第6章 告警中心（详细版 - 基于 alarm/index.vue 源码分析）
function chapter6() {
  const s = [];
  s.push(H1('第6章 告警中心'));
  s.push(P('告警中心是 DCIM 系统的核心安全模块，集中管理全域告警信息。页面采用标签页（Tab）布局，包含 5 个功能标签页：告警记录、告警规则、告警屏蔽、升级规则、阈值规则。系统支持 4 级告警分类（紧急/重要/一般/提示），提供从告警触发到确认、处理、解除的完整闭环流程。'));
  s.push(...IMG('24-alarms.png'));
  s.push(P(''));

  // === 6.1 告警记录 ===
  s.push(H2('6.1 告警记录'));
  s.push(P('告警记录是告警中心的默认标签页，展示系统产生的所有告警事件。页面顶部为筛选区域，中部为告警统计栏，下方为告警数据表格。'));
  s.push(P(''));
  s.push(PBold('筛选条件：'));
  s.push(...B([
    '告警状态：下拉选择框，可选"活动"、"已确认"、"已解决"三种状态进行过滤',
    '告警级别：下拉选择框，可选"紧急"、"重要"、"一般"、"提示"四个级别',
    '设备类型：下拉选择框，按设备类型筛选告警来源',
    '"查询"按钮：点击后根据筛选条件刷新告警列表',
    '"重置"按钮：清空所有筛选条件，恢复默认显示',
  ]));
  s.push(P(''));
  s.push(PBold('统计栏：'));
  s.push(P('筛选区域下方显示 4 个彩色统计标签，分别以不同颜色标识各级别告警的当前数量：'));
  s.push(...B([
    '红色标签：紧急告警数量',
    '橙色标签：重要告警数量',
    '黄色标签：一般告警数量',
    '蓝色标签：提示告警数量',
  ]));
  s.push(P(''));
  s.push(PBold('告警列表表格列：'));
  s.push(...B([
    '复选框列：用于批量选择告警记录',
    '级别：以彩色标签显示告警级别（紧急/重要/一般/提示）',
    '升级：显示告警是否已被升级',
    '点位编码：触发告警的监控点位编码',
    '点位名称：触发告警的监控点位名称',
    '告警内容：告警的详细描述信息',
    '触发值：触发告警时的实际测量值',
    '阈值：告警阈值设定值',
    '状态：当前告警状态（活动/已确认/已解决）',
    '告警时间：告警首次触发的时间',
    '确认时间：运维人员确认告警的时间',
    '解决时间：告警被解决的时间',
    '持续时间：从告警触发到当前或解决的持续时长',
    '操作列：包含"确认"、"处理"、"解除"三个操作按钮',
  ]));
  s.push(P(''));
  s.push(PBold('批量操作：'));
  s.push(P('在筛选区域右侧有"批量确认 (N)"按钮，N 为当前选中的告警数量。勾选多条告警记录后，点击此按钮可一次性确认所有选中的告警。'));
  s.push(P(''));
  s.push(PBold('分页控件：'));
