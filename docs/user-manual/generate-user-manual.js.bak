// 由于需要自定义段落结构，改为在 forEach 循环后追加

function enriched_section_5_1_6() {
  const s = [];
  s.push(H3('5.1.6 三相接线配置'));
  s.push(P('三相接线配置页面用于管理 PDU 到机柜的三相供电接线关系，帮助运维人员掌握每台 PDU 的相位分配情况，监控三相不平衡度，确保配电系统安全稳定运行。页面采用左右分栏布局，左侧为 PDU 设备列表，右侧为选中 PDU 的接线详情。'));
  s.push(...IMG('08-power-topology.png'));
  s.push(P(''));

  s.push(PBold('页面布局：'));
  s.push(P(''));

  s.push(PBold('左侧面板 - PDU 设备列表：'));
  s.push(P('以表格形式展示所有 PDU 设备，包含以下列：'));
  s.push(...B([
    '设备编码：PDU 的唯一标识编码',
    '设备名称：PDU 的显示名称',
  ]));
  s.push(P('点击某一行 PDU 设备，右侧面板将加载该 PDU 的接线配置详情。'));
  s.push(P(''));

  s.push(PBold('右侧面板 - 接线配置详情：'));
  s.push(P('选中 PDU 后，右侧显示该 PDU 下所有机柜的三相接线映射表格，包含以下列：'));
  s.push(...B([
    '机柜编码：接入该 PDU 的机柜编码',
    '机柜名称：机柜的显示名称',
    '相位 A/B/C：以彩色标签（Tag）显示各相位的接线状态',
    '供电路径：显示"主路"或"备路"，标识该接线属于主供电还是备用供电',
    '额定电流(A)：该接线的额定电流值',
    '操作列：包含"编辑"和"删除"两个按钮',
  ]));
  s.push(P(''));

  s.push(PBold('"添加接线"按钮：'));
  s.push(P('位于右侧面板顶部，蓝色主按钮，带加号图标。注意：必须先在左侧选中一台 PDU 设备后，此按钮才可点击（未选中 PDU 时按钮为禁用状态）。'));
  s.push(P(''));

  s.push(PBold('添加/编辑接线对话框（宽度 520px）：'));
  s.push(P('点击"添加接线"按钮或操作列的"编辑"按钮，弹出接线配置对话框，包含以下字段：'));
  s.push(...B([
    '机柜：下拉选择框（支持搜索过滤），选择要接入的目标机柜',
    '相位：单选按钮组，可选"A相"、"B相"、"C相"',
    '供电路径：单选按钮组，可选"主路"、"备路"',
    '额定电流(A)：数字输入框，范围 0-1000，精度 0.1',
    '描述：多行文本输入框（2行高度），填写接线的补充说明',
  ]));
  s.push(P(''));

  s.push(PBold('三相不平衡度监控：'));
  s.push(P('页面下方展示 3 个 ECharts 仪表盘图表，分别显示 A 相、B 相、C 相的功率（单位 kW）。每个仪表盘下方列出该相位接入的机柜清单。系统自动计算三相不平衡度，并以颜色标识：'));
  s.push(...B([
    '绿色（<15%）：三相平衡良好',
    '黄色（15%-30%）：三相轻度不平衡，建议调整',
    '红色（>30%）：三相严重不平衡，需要立即调整负载分配',
  ]));
  s.push(P(''));

  s.push(PBold('删除确认：'));
  s.push(P('点击操作列的"删除"按钮时，系统弹出确认对话框，提示"确定删除该接线配置吗？"，点击"确定"后删除该条接线记录。'));
  s.push(P(''));

  s.push(PBold('操作步骤 - 添加新接线：'));
  s.push(...STEPS([
    '在左侧 PDU 设备列表中，点击选中目标 PDU 设备',
    '点击右侧面板顶部的"添加接线"按钮（蓝色，带加号图标）',
    '在弹出的对话框中，从"机柜"下拉框搜索并选择目标机柜',
    '选择相位（A相/B相/C相），建议参考下方三相不平衡度图表选择负载较轻的相位',
    '选择供电路径（主路/备路）',
    '填写额定电流值（如 32A）',
    '可选填写描述信息',
    '点击"确定"按钮保存接线配置',
  ]));
  s.push(P(''));

  s.push(PBold('操作步骤 - 优化三相平衡：'));
  s.push(...STEPS([
    '查看页面下方的三相不平衡度仪表盘',
    '如果不平衡度显示为黄色或红色，查看各相位的机柜清单',
    '找出负载最重的相位和负载最轻的相位',
    '选择负载最重相位中的某台机柜，点击"编辑"按钮',
    '将其相位修改为负载最轻的相位',
    '保存后观察不平衡度是否改善',
    '重复调整直到不平衡度降至绿色范围（<15%）',
  ]));
  s.push(NOTE('三相不平衡度过高会导致变压器过热、线路损耗增大，严重时可能触发保护装置动作。建议定期检查并保持不平衡度在 15% 以内。'));
  s.push(P(''));

  return s;
}


// 7.1.1 能效监控 - 配电系统拓扑（详细版 - 基于 energy/topology.vue 源码分析）
