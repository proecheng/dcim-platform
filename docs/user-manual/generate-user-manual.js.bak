  s.push(...B([
    '操作类型：下拉选择框，可选"跟进"、"处理"、"备注"、"转交"、"其他"',
    '内容：多行文本输入框（4行高度），填写日志内容',
    '操作人：文本输入框，填写操作人姓名',
  ]));
  s.push(P(''));

  s.push(PBold('完成工单对话框（宽度 500px）：'));
  s.push(P('点击操作列的"完成"按钮，弹出完成确认对话框，包含以下字段：'));
  s.push(...B([
    '解决方案：多行文本输入框（4行高度），填写问题的解决方案',
    '根因分析：多行文本输入框（3行高度），填写问题的根本原因分析',
  ]));
  s.push(P(''));

  s.push(PBold('操作步骤 - 创建工单：'));
  s.push(...STEPS([
    '点击工具栏的"新建工单"按钮',
