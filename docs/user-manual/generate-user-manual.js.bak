// ========== 附录B ==========
function appendixB() {
  return [
    H1('附录B 常见问题解答（FAQ）'),
    P(''),
    H2('B.1 登录相关'),
    PBold('Q：登录时返回 500 Internal Server Error'),
    P('A：这通常是 bcrypt 库版本兼容性问题。bcrypt 5.0+ 与 passlib 1.7.4 不兼容。解决方法：进入 backend 目录，执行 pip install "bcrypt==4.0.1"，然后重启后端服务。'),
    P(''),
    PBold('Q：忘记管理员密码'),
    P('A：可通过数据库直接重置。SQLite 环境下，使用 Python 脚本重新生成 bcrypt 哈希并更新 users 表的 hashed_password 字段。'),
    P(''),
    H2('B.2 服务启动相关'),
    PBold('Q：端口 8080 或 3000 被占用'),
    P('A：Windows 下执行 netstat -ano | findstr ":8080" | findstr "LISTENING" 查看占用进程，然后 taskkill /F /PID <进程ID> 杀掉。或直接运行 stop.bat。'),
    P(''),
    PBold('Q：前端修改后不生效'),
    P('A：start.bat 使用静态文件模式，修改前端代码后需执行 cd frontend && npm run build 重新构建，然后 Ctrl+Shift+R 强制刷新浏览器。开发时建议使用 npm run dev。'),
    P(''),
    H2('B.3 数据相关'),
    PBold('Q：数据库表不存在'),
    P('A：进入 backend 目录，执行 alembic upgrade head 运行数据库迁移。如果问题持续，可删除 dcim.db 文件重启后端，系统会自动创建表和初始数据（注意：会丢失已有数据）。'),
    P(''),
    PBold('Q：仪表盘数据不更新'),
    P('A：检查 WebSocket 连接状态（浏览器开发者工具 → Network → WS）。如果连接断开，检查后端服务是否正常运行。如果模拟器已关闭且未接入真实设备，则无数据更新是正常的。'),
    P(''),
    H2('B.4 性能相关'),
    PBold('Q：页面加载缓慢'),
    P('A：检查网络连接和后端服务负载。生产环境建议使用 PostgreSQL + Redis 替代 SQLite，并启用 Nginx 静态资源缓存和 Gzip 压缩。'),
    P(''),
    PBold('Q：Docker 构建失败'),
    P('A：执行 docker compose down -v && docker system prune -f && docker compose up -d --build 清理并重新构建。'),
    BREAK(),
  ];
}

// ========== 文档组装与生成 ==========

async function main() {
  console.log('开始生成 DCIM 系统用户使用说明书...');

  const allChildren = [
    ...coverPage(),
    ...revisionHistory(),
    ...chapter1(),
    ...chapter2(),
    ...chapter3(),
    ...chapter4(),
    ...chapter5(),
    ...chapter6(),
    ...chapter7(),
    ...chapter8(),
    ...chapter9(),
    ...chapter10(),
    ...appendixA(),
    ...appendixB(),
  ];

  console.log(`共生成 ${allChildren.length} 个段落元素`);

  const doc = new Document({
    numbering: NUMBERING_CONFIG,
    styles: {
      default: {
        document: {
          run: { font: 'Microsoft YaHei', size: 22 },
        },
      },
    },
    sections: [{
      properties: {
        page: {
          size: { width: 11906, height: 16838 },
          margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 },
        },
      },
      headers: {
        default: new Header({
          children: [new Paragraph({
            alignment: AlignmentType.CENTER,
            children: [new TextRun({ text: '算力中心智能监控系统 用户使用说明书', bold: true, size: 18, font: 'Microsoft YaHei', color: '999999' })],
          })],
        }),
      },
      footers: {
        default: new Footer({
          children: [new Paragraph({
            alignment: AlignmentType.CENTER,
            children: [
              new TextRun({ text: '第 ', size: 18, font: 'Microsoft YaHei' }),
              new TextRun({ children: [PageNumber.CURRENT], size: 18, font: 'Microsoft YaHei' }),
              new TextRun({ text: ' 页', size: 18, font: 'Microsoft YaHei' }),
            ],
          })],
        }),
      },
      children: allChildren,
    }],
  });

  const buffer = await Packer.toBuffer(doc);
  const dir = path.dirname(OUTPUT_PATH);
  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
  fs.writeFileSync(OUTPUT_PATH, buffer);
  console.log('文档已生成: ' + OUTPUT_PATH);
  console.log('文件大小: ' + (buffer.length / 1024).toFixed(1) + ' KB');
}

main().catch(err => {
  console.error('生成失败:', err);
  process.exit(1);
});

