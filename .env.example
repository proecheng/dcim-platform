# ============================================================
# DCIM Docker Compose 环境变量配置
# 复制此文件为 .env 并修改对应值
# cp .env.example .env
# ============================================================

# ─── PostgreSQL + TimescaleDB ────────────────────────────────
POSTGRES_DB=dcim
POSTGRES_USER=dcim
POSTGRES_PASSWORD=dcim_password          # 生产环境必须更改！
POSTGRES_PORT=5432

# ─── TimescaleDB ─────────────────────────────────────────────
TIMESCALEDB_ENABLED=true                 # 启用 hypertable 压缩与保留策略

# ─── Story 39.3 PostgreSQL 灾备（仅 deploy/dr profile）──────
# 正式 DR 镜像必须由本仓库 Dockerfile 构建、发布并填写真实 manifest digest。
DCIM_POSTGRES_IMAGE=<registry>/dcim-postgres:16.15-ts2.29.1-pgb2.59.0@sha256:<verified-manifest-digest>
POSTGRES_PASSWORD_FILE=<absolute-path-to-postgres-password-secret>
REPLICATION_PASSWORD_FILE=<absolute-path-to-replication-password-secret>
PGBACKREST_CIPHER_PASS_FILE=<absolute-path-to-pgbackrest-cipher-secret>
FENCE_TOKEN_FILE=<absolute-path-to-fence-token-secret>
PGBACKREST_REPOSITORY_VOLUME=<external-encrypted-repository-volume>
BACKUP_FULL_WEEKDAY=0                    # UTC，0 表示星期日
BACKUP_DAILY_HOUR=2                      # UTC，每周 full 或每日 differential
BACKUP_INCREMENTAL_HOURS=8,14,20         # UTC，逗号分隔
RESTORE_TARGET_TYPE=latest               # latest、time、lsn 或 name
RESTORE_TARGET_VALUE=                    # latest 必须为空，其他类型必须提供严格值
EXPECTED_ALEMBIC_HEAD=20260707_0100       # 必须与当前发布镜像的唯一 Alembic head 一致

# ─── Redis ───────────────────────────────────────────────────
REDIS_PORT=6379

# ─── EMQX MQTT ───────────────────────────────────────────────
MQTT_PORT=1883                           # MQTT TCP 端口
MQTT_WS_PORT=8083                        # MQTT WebSocket 端口
EMQX_DASHBOARD_PORT=18083                # EMQX 管理面板
MQTT_USERNAME=                           # MQTT 认证用户名（可选）
MQTT_PASSWORD=                           # MQTT 认证密码（可选）

# ─── 后端 FastAPI ────────────────────────────────────────────
APP_NAME=算力中心智能监控系统
DEBUG=false                              # 生产环境必须设为 false
BACKEND_PORT=8080                        # 后端对外端口

# JWT — 生产环境必须更改！
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — 允许的前端地址
CORS_ORIGINS=http://localhost:3000

# 数据采集
SIMULATION_ENABLED=true                  # 模拟数据开关
COLLECT_INTERVAL=10                      # 采集间隔（秒）
DATA_RETENTION_DAYS=30                   # 数据保留天数
MAX_POINTS=100                           # 最大点位数

# ─── 前端 Nginx ──────────────────────────────────────────────
NGINX_PORT=3000                          # 系统入口端口
