# 应用配置
APP_NAME=算力中心智能监控系统
APP_VERSION=2.0.0
DEBUG=false  # 生产环境必须设为 false

# 数据库配置 — 通过 DATABASE_URL 切换 SQLite / PostgreSQL
# SQLite（开发环境，默认）:
DATABASE_URL=sqlite+aiosqlite:///./dcim.db
# PostgreSQL + TimescaleDB（生产环境）:
# DATABASE_URL=postgresql+asyncpg://dcim:dcim_password@localhost:5432/dcim

# TimescaleDB 开关（仅 PostgreSQL 生效）
TIMESCALEDB_ENABLED=false

# JWT 配置 - 重要：生产环境必须更改！
# 使用以下命令生成安全的密钥：python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30  # 建议30分钟

# CORS 配置 - 逗号分隔的允许来源
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 数据采集配置
COLLECT_INTERVAL=10
DATA_RETENTION_DAYS=30

# 授权配置
LICENSE_KEY=DEMO-0000-0000-0000
MAX_POINTS=100
