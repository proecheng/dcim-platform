# ============================================================
# DCIM 后端环境变量配置
# 复制此文件为 .env 并修改对应值
# cp .env.example .env
# ============================================================

# ─── 应用配置 ────────────────────────────────────────────────
APP_NAME=算力中心智能监控系统
APP_VERSION=3.0.0
APP_ENV=development
DEBUG=false                              # 生产环境必须设为 false
SQL_ECHO=false                           # 仅排查 SQL 时临时开启

# 服务器配置
HOST=0.0.0.0
PORT=8080

# ─── 数据库配置 ──────────────────────────────────────────────
# 通过 DATABASE_URL 切换 SQLite / PostgreSQL
# SQLite（开发环境，默认）:
DATABASE_URL=sqlite+aiosqlite:///./dcim.db
# PostgreSQL + TimescaleDB（生产环境）:
# DATABASE_URL=postgresql+asyncpg://dcim:dcim_password@localhost:5432/dcim

# TimescaleDB 开关（仅 PostgreSQL 生效）
TIMESCALEDB_ENABLED=false

# ─── JWT 认证 ────────────────────────────────────────────────
# 重要：生产环境必须更改！
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30           # 生产建议 30 分钟
REFRESH_TOKEN_EXPIRE_DAYS=7              # 刷新令牌过期天数

# ─── CORS 配置 ───────────────────────────────────────────────
# 逗号分隔的允许来源
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── 数据采集配置 ────────────────────────────────────────────
COLLECT_INTERVAL=10                      # 采集间隔（秒）
DATA_RETENTION_DAYS=30                   # 数据保留天数

# ─── 模拟模式配置 ────────────────────────────────────────────
SIMULATION_ENABLED=true                  # 是否启用模拟数据（生产环境设为 false）
SIMULATION_INTERVAL=5                    # 模拟数据生成间隔（秒）
SIMULATION_BATCH_SIZE=300                # 每轮最多更新点位数，避免 SQLite 长时间写锁

# ─── 授权配置 ────────────────────────────────────────────────
LICENSE_KEY=DEMO-0000-0000-0000
MAX_POINTS=100                           # 最大监控点位数

# ─── Redis 配置 ──────────────────────────────────────────────
REDIS_ENABLED=true                       # 不需要 Redis 时设为 false
REDIS_URL=redis://localhost:6379/0

# ─── MQTT 配置 ───────────────────────────────────────────────
MQTT_ENABLED=true                        # 不需要 MQTT 时设为 false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=                           # MQTT 认证用户名（可选）
MQTT_PASSWORD=                           # MQTT 认证密码（可选）
MQTT_CLIENT_ID=dcim-backend

# ─── 故障树 HMAC 签名（Story 24.4）──────────────────────────
# 重要：生产环境必须设置！至少 32 字符
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
FAULT_TREE_HMAC_KEY=your-secret-key-at-least-32-chars-long-change-this-in-production
# 旧密钥（密钥轮换时使用，可选）
# FAULT_TREE_HMAC_KEY_PREVIOUS=old-secret-key
