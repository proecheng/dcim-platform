# Copy this file outside the repository and replace every placeholder.
# Never commit the populated file.

CANDIDATE_GIT_SHA=ba1177448958c90e7ab979a3666f8719208c2f8f
DCIM_BACKEND_IMAGE=ghcr.io/proecheng/dcim-platform/backend@sha256:2024d5d0e953153674a769307dbfccb840cbe47596e3277a8efbb09b17b626fc
DCIM_BACKEND_EXPECTED_ID=sha256:2024d5d0e953153674a769307dbfccb840cbe47596e3277a8efbb09b17b626fc
DCIM_FRONTEND_IMAGE=ghcr.io/proecheng/dcim-platform/frontend@sha256:28f85db1baf1f039614c2e1ea4b4a4a1fc610bfda3c30ce239f7b018f6ee0032
DCIM_FRONTEND_EXPECTED_ID=sha256:28f85db1baf1f039614c2e1ea4b4a4a1fc610bfda3c30ce239f7b018f6ee0032

# Pin every dependency to a registry manifest digest before deployment.
DCIM_REDIS_IMAGE=redis:7-alpine@sha256:<verified-redis-manifest-digest>
DCIM_EMQX_IMAGE=emqx/emqx:5@sha256:<verified-emqx-manifest-digest>

# Story 39.3 must already provide these external resources.
DCIM_DR_STATUS_VOLUME=dcim-story-39-3-dr_dr-status
DCIM_DR_DATABASE_NETWORK=dcim-story-39-3-dr_database-client

APP_NAME="DCIM Preproduction"
DATABASE_URL=postgresql+asyncpg://dcim:<url-encoded-password>@postgres-writer:5432/dcim
TIMESCALEDB_ENABLED=true
SECRET_KEY=<random-secret-at-least-48-characters>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=https://<preproduction-hostname>

REDIS_PASSWORD=<strong-redis-password>
REDIS_URL=redis://:<url-encoded-redis-password>@redis:6379/0
MQTT_USERNAME=<preproduction-mqtt-user>
MQTT_PASSWORD=<strong-mqtt-password>
GATEWAY_SECRET_KEY=<random-secret-at-least-32-characters>
VPP_API_KEY=<random-secret-at-least-32-characters>
LICENSE_KEY=<preproduction-license>
FAULT_TREE_HMAC_KEY=<random-secret-at-least-32-characters>

COLLECT_INTERVAL=10
DATA_RETENTION_DAYS=30
MAX_POINTS=100
PREPROD_BIND_ADDRESS=127.0.0.1
NGINX_PORT=3000

# Used by the Playwright runner, not injected into the application container.
E2E_ADMIN_USER=<dedicated-e2e-admin>
E2E_ADMIN_PASSWORD=<dedicated-e2e-password>
