import { test, expect } from '@playwright/test';

// Playwright E2E 测试：资产、运维、系统与采集配置页面的基础加载与可见性
// 说明：使用全局 storageState 进行认证，无需在测试中指定 storageState
// 注意：URL 路径基于项目配置的 baseURL，直接传入相对路径进行导航

// 工具函数：判断页面是否存在主要内容区域
const hasMainContent = async (page: any) => {
  const mainVisible = await page.locator('.el-main').isVisible().catch(() => false);
  if (mainVisible) return true;
  const mainTagVisible = await page.locator('main').isVisible().catch(() => false);
  if (mainTagVisible) return true;
  const appMainVisible = await page.locator('.app-main').isVisible().catch(() => false);
  return appMainVisible || mainTagVisible;
};

// 资产与容量域
test.describe('资产与容量', () => {
  test('资产台账 /asset/list 页面加载、URL 正确、可见表格区域', async ({ page }) => {
    await page.goto('/asset/list');
    await page.waitForLoadState('networkidle');
    await page.waitForTimeout(1000);
    await expect(page).toHaveURL(/\/asset\/list(\?|$)/);
    const mainOk = await hasMainContent(page);
    expect(mainOk).toBeTruthy();
    const hasTable = await page.locator('table').first().isVisible().catch(() => false);
    const hasElTable = await page.locator('.el-table').first().isVisible().catch(() => false);
    const hasCard = await page.locator('.el-card').first().isVisible().catch(() => false);
    const uiVisible = hasTable || hasElTable || hasCard;
    expect(uiVisible).toBeTruthy();
  });

  test('机柜管理 /asset/cabinet 页面加载、URL 正确、可见卡片或表格', async ({ page }) => {
    await page.goto('/asset/cabinet');
    await page.waitForLoadState('networkidle');
    await page.waitForTimeout(1000);
    await expect(page).toHaveURL(/\/asset\/cabinet(\?|$)/);
    const mainOk = await hasMainContent(page);
    expect(mainOk).toBeTruthy();
    const uiVisible = await Promise.resolve(
      (await page.locator('.el-table').first().isVisible().catch(() => false)) ||
      (await page.locator('.el-card').first().isVisible().catch(() => false)) ||
      (await page.locator('table').first().isVisible().catch(() => false))
    );
    expect(uiVisible).toBeTruthy();
  });

  test('容量管理 /asset/capacity 页面加载、URL 正确、可见表单/内容区域', async ({ page }) => {
    await page.goto('/asset/capacity');
    await page.waitForLoadState('networkidle');
    await page.waitForTimeout(1000);
    await expect(page).toHaveURL(/\/asset\/capacity(\?|$)/);
    const mainOk = await hasMainContent(page);
    expect(mainOk).toBeTruthy();
    const hasForm = await page.locator('form').first().isVisible().catch(() => false);
    const hasCard = await page.locator('.el-card').first().isVisible().catch(() => false);
    expect(hasForm || hasCard).toBeTruthy();
  });

  test('空间拓扑 /asset/spatial 页面加载、URL 正确、可见区域', async ({ page }) => {
    await page.goto('/asset/spatial');
    await page.waitForLoadState('networkidle');
    await page.waitForTimeout(1000);
    await expect(page).toHaveURL(/\/asset\/spatial(\?|$)/);
    const mainOk = await hasMainContent(page);
    expect(mainOk).toBeTruthy();
    const hasElTable = await page.locator('.el-table').first().isVisible().catch(() => false);
    const hasCard = await page.locator('.el-card').first().isVisible().catch(() => false);
    expect(hasElTable || hasCard).toBeTruthy();
  });
});

